---
/*
 * Botón flotante de WhatsApp, solo en móvil. Aparece tras bajar un poco
 * (no tapa la portada) y se esconde en /contacto, donde ya está la línea directa.
 * El clic lo mide ContactTracking (contact_click, method=whatsapp) por delegación.
 */
import { SITE, hasWhatsapp } from "../config/site.mjs";
const path = Astro.url.pathname.replace(/\/$/, "");
const show = hasWhatsapp() && path !== "/contacto";
const text = encodeURIComponent("Hola, escribo desde la web de Black Sun Prods.");
---
{show && (
  <a class="waf" id="waf" href={`https://wa.me/${SITE.whatsapp}?text=${text}`} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.1-.2-.2-.5-.3Z"/></svg>
  </a>
)}
<script is:inline>
  (function () {
    var b = document.getElementById("waf");
    if (!b) return;
    function check() { b.classList.toggle("is-on", window.scrollY > window.innerHeight * 0.6); }
    window.addEventListener("scroll", check, { passive: true });
    check();
  })();
</script>
<style>
  .waf {
    display: none;
    position: fixed;
    right: calc(16px + env(safe-area-inset-right, 0px));
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 900;
    width: 52px; height: 52px; border-radius: 50%;
    align-items: center; justify-content: center;
    background: #0F0C0A; color: #EDE8E1;
    border: 1px solid rgba(184, 50, 42, 0.7);
    box-shadow: 0 10px 30px -8px rgba(150, 34, 24, 0.6);
    opacity: 0; transform: translateY(12px); pointer-events: none;
    transition: opacity .35s ease, transform .35s ease;
  }
  .waf.is-on { opacity: 1; transform: none; pointer-events: auto; }
  .waf:focus-visible { outline: 2px solid #EDE8E1; outline-offset: 3px; }
  @media (max-width: 768px) { .waf { display: flex; } }
  @media (prefers-reduced-motion: reduce) { .waf { transition: none; } }
</style>
