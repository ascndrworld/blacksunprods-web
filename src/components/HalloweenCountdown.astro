    16% { opacity: 0; }
    24% { opacity: 1; clip-path: inset(40% 0 20% 0); transform: translateX(4%); }
    34% { opacity: 1; clip-path: inset(0 0 0 0); transform: translateX(-1.5%) skewX(-4deg); }
    46% { opacity: 0.2; }
