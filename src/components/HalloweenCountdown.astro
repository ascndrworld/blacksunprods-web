---
/*
 * /countdown — Landing secreta del teaser de HALLOWEEN FEST V.
 * URL pública: https://halloweenfest.blacksunprods.com/countdown (el QR).
 *
 * Solo se llega por el QR: no se enlaza desde ninguna página, va con
 * noindex y está excluida del sitemap (filtro en astro.config.mjs).
 * Página independiente a propósito: NO usa Layout (sin header, footer,
 * banner de cookies ni logos de Black Sun Prods).
 *
 * Fondo: la ambientación oficial de la edición (public/images/halloween-v).
 * La versión apaisada es la misma escena ampliada por los lados, con el
 * original encajado a resolución completa en el centro. La V latente es la
 * escena oficial con la V superpuesta casi transparente: las dos imágenes
 * coinciden píxel a píxel salvo en la V, así que solo asoma la letra.
 *
 * Cuenta atrás hasta el viernes 2 de octubre de 2026, 15:45 Europe/Madrid.
 * Ese día Madrid está en horario de verano (CEST, UTC+2; el cambio es el
 * 25/10), así que el instante exacto es 13:45:00 UTC. Se fija con su offset
 * explícito: no depende de la zona horaria del dispositivo. Además, el reloj
 * se contrasta con la cabecera Date del servidor por si el móvil va desfasado.
 */
import Analytics from "./Analytics.astro";
import { absUrl } from "../config/site.mjs";

const TARGET_ISO = "2026-10-02T15:45:00+02:00";
const TARGET = Date.parse(TARGET_ISO);
// Solo en local (npm run dev): /countdown?demo=10 termina a los 10 s para
// ensayar la secuencia final. En el build de producción no existe.
const DEV = import.meta.env.DEV;
const TAGLINE = "The game begins";
const IMG = "/images/halloween-v";

// Dos relojes posibles sobre la misma escena:
//  · "led": marcador LED de 7 segmentos tras el cristal de la caja.
//  · "grabado": sin cristal; los números van arañados en una placa de acero.
export interface Props { reloj?: "led" | "grabado" }
const { reloj = "led" } = Astro.props;
const RELOJ = reloj;
const BG = reloj === "grabado" ? "grabado" : "ambiente";
const ogImage = absUrl(`${IMG}/${BG}-horizontal.webp`);

// Dígito LED de 7 segmentos (a–g), dibujado en SVG: sin fuentes ni librerías.
// Rejilla de 60×100; cada segmento es un hexágono alargado como en los
// marcadores de gimnasio.
const T = 9;   // grosor del segmento
const G = 2.2; // separación entre segmentos
const L = 6, R = 54, TOP = 6, MID = 50, BOT = 94;
const h = (y: number, x1: number, x2: number) =>
  `${x1},${y} ${x1 + T / 2},${y - T / 2} ${x2 - T / 2},${y - T / 2} ${x2},${y} ${x2 - T / 2},${y + T / 2} ${x1 + T / 2},${y + T / 2}`;
const v = (x: number, y1: number, y2: number) =>
  `${x},${y1} ${x + T / 2},${y1 + T / 2} ${x + T / 2},${y2 - T / 2} ${x},${y2} ${x - T / 2},${y2 - T / 2} ${x - T / 2},${y1 + T / 2}`;
const SEGMENTS = [
  ["a", h(TOP, L + G, R - G)],
  ["b", v(R, TOP + G, MID - G)],
  ["c", v(R, MID + G, BOT - G)],
  ["d", h(BOT, L + G, R - G)],
  ["e", v(L, MID + G, BOT - G)],
  ["f", v(L, TOP + G, MID - G)],
  ["g", h(MID, L + G, R - G)],
];
const GROUPS = [
  { u: "d", label: "Days" },
  { u: "h", label: "Hours" },
  { u: "m", label: "Minutes" },
  { u: "s", label: "Seconds" },
];
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
  <title>V</title>
  <meta name="description" content="Halloween Fest V."/>
  <meta name="robots" content="noindex, nofollow, noarchive"/>
  <meta name="theme-color" content="#000000"/>
  <meta name="color-scheme" content="dark"/>
  <meta name="apple-mobile-web-app-capable" content="yes"/>
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
  <meta name="format-detection" content="telephone=no"/>

  <meta property="og:type" content="website"/>
  <meta property="og:title" content="V"/>
  <meta property="og:description" content="Halloween Fest V."/>
  <meta property="og:image" content={ogImage}/>
  <meta name="twitter:card" content="summary_large_image"/>

  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3"/>

  <!-- Si ya pasó la fecha, se entra directamente en el estado final (sin parpadeo del contador). -->
  <script is:inline define:vars={{ TARGET, DEV, RELOJ }}>
    window.__cdTarget = TARGET;
    window.__reloj = RELOJ;
    if (DEV) {
      var demo = parseInt(new URLSearchParams(location.search).get("demo"), 10);
      if (demo >= 0) window.__cdTarget = Date.now() + demo * 1000;
    }
    if (Date.now() >= window.__cdTarget) document.documentElement.setAttribute("data-state", "final");
  </script>

  <Analytics />

  <link rel="preload" href="/fonts/helvetica-neue/HelveticaNeueMedium.woff2" as="font" type="font/woff2" crossorigin/>
  <link rel="preload" href="/fonts/helvetica-neue/HelveticaNeueBold.woff2" as="font" type="font/woff2" crossorigin/>
  <link rel="preload" as="image" href={`${IMG}/${BG}-vertical.webp`} media="(max-aspect-ratio: 1/1)"/>
  <link rel="preload" as="image" href={`${IMG}/${BG}-horizontal.webp`} media="(min-aspect-ratio: 1/1)"/>
</head>
<body>
  <main class="stage">
    <h1 class="sr-only">Halloween Fest V</h1>

    <!-- ── Escena: ambientación oficial con el reloj colgado de cadenas ──
         El reloj y las cadenas forman parte de la foto (editada en la propia
         escena para que compartan luz, niebla y perspectiva). Los dígitos LED
         son vivos y van anclados al cristal de la foto: .scene tiene la misma
         proporción que la imagen, así que los porcentajes de .screen caen
         siempre sobre el cristal, se recorte como se recorte la escena. -->
    <div class="bg">
      <div class:list={["scene", `scene--${reloj}`]}>
        <picture aria-hidden="true">
          <source media="(min-aspect-ratio: 1/1)" srcset={`${IMG}/${BG}-horizontal.webp`} width="1958" height="1402"/>
          <img class="scene-img" src={`${IMG}/${BG}-vertical.webp`} width="1122" height="1402" alt="" fetchpriority="high" decoding="async"/>
        </picture>
        <picture aria-hidden="true">
          <source media="(min-aspect-ratio: 1/1)" srcset={`${IMG}/${BG}-v-horizontal.webp`} width="1958" height="1402"/>
          <img class="scene-img scene-v" src={`${IMG}/${BG}-v-vertical.webp`} width="1122" height="1402" alt="" decoding="async"/>
        </picture>

        <!-- ── Cuenta atrás: dígitos LED sobre el cristal del reloj ── -->
        <div class="screen">
          <div class:list={["led", `led--${reloj}`]} role="timer" aria-label="Cuenta atrás">
            <div class="led-face">
              {GROUPS.map((g, i) => (
                <Fragment>
                  {i > 0 && (reloj === "grabado"
                    ? <svg class="scr-colon" viewBox="0 0 20 100" aria-hidden="true" data-colon={i}></svg>
                    : <span class="led-colon" aria-hidden="true"><i></i><i></i></span>)}
                  <div class="led-group">
                    <div class="led-digits" data-u={g.u}>
                      {[0, 1].map(() => reloj === "grabado" ? (
                        <svg class="led-digit scr-digit" viewBox="-6 -6 72 112" aria-hidden="true"></svg>
                      ) : (
                        <svg class="led-digit" viewBox="0 0 60 100" aria-hidden="true">
                          {SEGMENTS.map(([id, pts]) => <polygon class={`s s-${id}`} points={pts}/>)}
                        </svg>
                      ))}
                    </div>
                    <span class="led-label" aria-hidden="true">{g.label}</span>
                  </div>
                </Fragment>
              ))}
            </div>
            <span class="sr-only" data-sr></span>
          </div>
        </div>

      </div>
      {reloj === "grabado" && (
        <svg width="0" height="0" style="position:absolute" aria-hidden="true">
          <filter id="rasgado" x="-10%" y="-30%" width="120%" height="160%">
            <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7"/>
            <feDisplacementMap in="SourceGraphic" scale="2.4"/>
          </filter>
        </svg>
      )}
      <div class="bg-smoke bg-smoke--a" aria-hidden="true"></div>
      <div class="bg-smoke bg-smoke--b" aria-hidden="true"></div>
      <div class="bg-vignette" aria-hidden="true"></div>
    </div>

    <!-- ── Estado final ── -->
    <div class="blackout" aria-hidden="true"></div>
    <div class="final">
      <div class="final-glow" aria-hidden="true"></div>
      <p class="final-kicker">
        <span class="fk-1">Halloween Fest</span>
        <span class="fk-2">5º Aniversario</span>
      </p>
      <div class="final-v" role="img" aria-label="V">
        <img src={`${IMG}/v-final.webp`} width="800" height="800" alt="" decoding="async"/>
        <img src={`${IMG}/v-final.webp`} width="800" height="800" alt="" aria-hidden="true" decoding="async"/>
        <img src={`${IMG}/v-final.webp`} width="800" height="800" alt="" aria-hidden="true" decoding="async"/>
        <img class="final-sheen" src={`${IMG}/v-final.webp`} width="800" height="800" alt="" aria-hidden="true" decoding="async"/>
      </div>
      <p class="final-t" aria-label={TAGLINE}>
        <span class="final-rule" aria-hidden="true"></span>
        <span class="final-words" aria-hidden="true">
          {TAGLINE.split(" ").map((word, w, words) => (
            <span class="final-word">
              {word.split("").map((ch, c) => (
                <span class="l" style={`--i:${words.slice(0, w).join("").length + c}`}>{ch}</span>
              ))}
            </span>
          ))}
        </span>
        <span class="final-rule" aria-hidden="true"></span>
      </p>
      <p class="final-date"><time datetime="2026-10-31">31/10/2026</time></p>
      <canvas class="embers" aria-hidden="true"></canvas>
    </div>
    <div class="flash" aria-hidden="true"></div>
    <div class="whip" aria-hidden="true"></div>

    <!-- ── Transición VHS: estática, líneas de barrido, apagado de tubo y OSD ── -->
    <canvas class="vhs-noise" aria-hidden="true"></canvas>
    <div class="vhs-scan" aria-hidden="true"></div>
    <div class="crt-dot" aria-hidden="true"></div>
    <div class="osd" aria-hidden="true">
      <span class="osd-ch">CH 05</span>
      <span class="osd-play">&#9654; PLAY</span>
      <span class="osd-ns">NO SIGNAL</span>
    </div>

    <div class="grain" aria-hidden="true"></div>
  </main>

  <script is:inline>
    (function () {
      var TARGET = window.__cdTarget;
      var root = document.documentElement;
      var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Segmentos encendidos por cifra.
      var MAP = ["abcdef", "bc", "abdeg", "abcdg", "bcfg", "acdfg", "acdefg", "abc", "abcdefg", "abcdfg"];
      var units = {};
      var slot = 0;
      [].forEach.call(document.querySelectorAll(".led-digits"), function (el) {
        units[el.getAttribute("data-u")] = [].map.call(el.querySelectorAll(".led-digit"), function (svg) {
          return { svg: svg, segs: svg.querySelectorAll(".s"), val: -1, slot: slot++ };
        });
      });
      var sr = document.querySelector("[data-sr]");
      var GRABADO = window.__reloj === "grabado";

      // ── Reloj grabado: cada cifra son trazos arañados en el acero. El
      // esqueleto de cada número se recorre con 2–3 surcos paralelos,
      // irregulares y afilados en las puntas. La semilla depende de la
      // posición y la cifra, así que un mismo número nunca se repite igual
      // en dos casillas pero no cambia de forma mientras se ve.
      var SK = [
        [[[14,7],[49,9],[47,93]], [[46,94],[12,91],[11,8]]],
        [[[21,22],[37,5],[34,96]]],
        [[[8,24],[21,6],[47,9],[50,31],[9,94]], [[8,93],[53,91]]],
        [[[9,8],[51,6],[25,45]], [[27,43],[51,58],[45,92],[7,89]]],
        [[[41,4],[6,65],[55,62]], [[41,28],[38,98]]],
        [[[51,6],[12,9],[10,45],[44,41],[51,70],[41,94],[7,89]]],
        [[[47,5],[15,40],[8,77],[24,96],[48,86],[50,58],[11,56]]],
        [[[6,8],[55,6],[21,98]], [[17,53],[45,50]]],
        [[[48,11],[14,6],[10,40],[50,61],[46,94],[10,92],[12,58],[48,38],[47,9]]],
        [[[49,41],[12,45],[10,8],[48,6],[51,50],[40,97]]]
      ];
      function rng(seed) {
        return function () {
          seed |= 0; seed = seed + 0x6D2B79F5 | 0;
          var t = Math.imul(seed ^ seed >>> 15, 1 | seed);
          t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
          return ((t ^ t >>> 14) >>> 0) / 4294967296;
        };
      }
      function f1(v) { return Math.round(v * 10) / 10; }
      // Un surco: polígono afilado que sigue la polilínea con temblor.
      function gouge(pts, off, maxW, r) {
        var P = [], i, j;
        for (i = 0; i < pts.length - 1; i++) {
          var a = pts[i], b = pts[i + 1], len = Math.hypot(b[0] - a[0], b[1] - a[1]), n = Math.max(2, Math.round(len / 3.5));
          for (j = 0; j < n; j++) P.push([a[0] + (b[0] - a[0]) * j / n, a[1] + (b[1] - a[1]) * j / n]);
        }
        P.push(pts[pts.length - 1]);
        var t0 = r() * 0.08, t1 = 1 - r() * 0.08, L = [], Rt = [];
        for (i = 0; i < P.length; i++) {
          var t = i / (P.length - 1);
          if (t < t0 || t > t1) continue;
          var p = P[i], q = P[Math.min(i + 1, P.length - 1)], o = P[Math.max(i - 1, 0)];
          var dx = q[0] - o[0], dy = q[1] - o[1], dl = Math.hypot(dx, dy) || 1, nx = -dy / dl, ny = dx / dl;
          var u = (t - t0) / (t1 - t0);
          var w = maxW * Math.pow(Math.sin(Math.PI * u), 0.55) * (0.65 + r() * 0.7);
          var jit = off + (r() - 0.5) * 1.1;
          // inclinación hacia delante, como escrito a mano con rabia
          var x = p[0] + (50 - p[1]) * 0.1 + nx * jit, y = p[1] + ny * jit;
          L.push(f1(x + nx * w / 2) + "," + f1(y + ny * w / 2));
          Rt.unshift(f1(x - nx * w / 2) + "," + f1(y - ny * w / 2));
        }
        return "M" + L.concat(Rt).join("L") + "Z";
      }
      function carve(svg, strokes, seed) {
        var r = rng(seed), sh = "", ed = "", co = "";
        strokes.forEach(function (st) {
          var n = 2 + (r() < 0.45 ? 1 : 0);
          for (var k = 0; k < n; k++) {
            var off = (k - (n - 1) / 2) * 3.4 + (r() - 0.5) * 1.2;
            var main = k === Math.floor(n / 2);
            var d = gouge(st, off, main ? 6.2 : 3.4, r);
            sh += '<path d="' + d + '"/>';
            ed += '<path d="' + d + '"/>';
            if (main || r() < 0.5) co += '<path d="' + gouge(st, off, main ? 2.6 : 1.3, rng(seed + k * 97)) + '"/>';
          }
        });
        svg.innerHTML = '<g class="sc-sh">' + sh + '</g><g class="sc-ed">' + ed + '</g><g class="sc-co">' + co + '</g>';
      }
      if (GRABADO) {
        [].forEach.call(document.querySelectorAll(".scr-colon"), function (svg, i) {
          carve(svg, [[[9, 30], [11, 40]], [[8, 62], [10, 72]]], 900 + i);
        });
      }

      function paint(d, n) {
        if (d.val === n) return;
        var first = d.val === -1;
        d.val = n;
        if (GRABADO) {
          carve(d.svg, SK[n], d.slot * 131 + n * 17 + 5);
          // El surco recién tallado brilla un instante
          if (!first && !reduce) {
            d.svg.classList.remove("fresh"); void d.svg.getBoundingClientRect(); d.svg.classList.add("fresh");
          }
          return;
        }
        var on = MAP[n];
        for (var i = 0; i < d.segs.length; i++) {
          d.segs[i].classList.toggle("on", on.indexOf("abcdefg".charAt(i)) !== -1);
        }
      }

      // Desfase entre el reloj del dispositivo y el del servidor (ms).
      var offset = 0;
      var timer = null;
      var ending = false;

      function now() { return Date.now() + offset; }
      function setState(s) {
        root.setAttribute("data-state", s);
        vhs.state(s);
        if (s === "v") { embers.start(true); vhs.burst(300, 0.3); }
        if (s === "final") tapeHits();
      }

      // ── Brasas: canvas 2D nativo. Estallan con el impacto de la V y luego
      // siguen subiendo despacio. Solo corre en el estado final.
      var embers = (function () {
        var cv = document.querySelector(".embers");
        var cx = cv && cv.getContext && cv.getContext("2d");
        var P = [], running = false, W = 0, H = 0, raf = 0;
        function size() {
          var dpr = Math.min(2, window.devicePixelRatio || 1);
          W = cv.clientWidth; H = cv.clientHeight;
          cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr);
          cx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
        function add(burst) {
          var r = Math.random;
          P.push(burst ? {
            x: W / 2 + (r() - 0.5) * Math.min(W, H) * 0.35, y: H * 0.44 + (r() - 0.2) * H * 0.12,
            vx: (r() - 0.5) * 7, vy: -(1.5 + r() * 6), life: 1, decay: 0.006 + r() * 0.012, s: 0.6 + r() * 1.8, ph: r() * 6
          } : {
            x: W * (0.15 + r() * 0.7), y: H + 10,
            vx: (r() - 0.5) * 0.4, vy: -(0.35 + r() * 0.9), life: 1, decay: 0.0018 + r() * 0.003, s: 0.5 + r() * 1.4, ph: r() * 6
          });
        }
        function frame(t) {
          if (!running) return;
          cx.clearRect(0, 0, W, H);
          cx.globalCompositeOperation = "lighter";
          if (P.length < (W < 600 ? 45 : 80) && Math.random() < 0.35) add(false);
          for (var i = P.length - 1; i >= 0; i--) {
            var p = P[i];
            p.vx *= 0.985; p.vy = p.vy * 0.985 - 0.012;
            p.x += p.vx + Math.sin(t / 700 + p.ph) * 0.25; p.y += p.vy;
            p.life -= p.decay;
            if (p.life <= 0 || p.y < -20) { P.splice(i, 1); continue; }
            var a = p.life * (0.6 + 0.4 * Math.sin(t / 90 + p.ph));
            cx.fillStyle = "rgba(255," + (50 + (p.ph * 12 | 0)) + ",20," + (a * 0.22).toFixed(3) + ")";
            cx.beginPath(); cx.arc(p.x, p.y, p.s * 2.2, 0, 6.283); cx.fill();
            cx.fillStyle = "rgba(255,170,110," + a.toFixed(3) + ")";
            cx.beginPath(); cx.arc(p.x, p.y, p.s * 0.7, 0, 6.283); cx.fill();
          }
          raf = requestAnimationFrame(frame);
        }
        return {
          start: function (burst) {
            if (!cx || reduce) return;
            size();
            if (burst) for (var i = 0; i < 110; i++) add(true);
            if (!running) { running = true; raf = requestAnimationFrame(frame); }
          },
          resize: function () { if (running) size(); }
        };
      })();
      window.addEventListener("resize", function () { embers.resize(); vhs.resize(); });

      // ── Estática VHS: canvas a un tercio de resolución (el propio escalado
      // la difumina como una cinta). Incluye barra de tracking que rueda y
      // líneas quemadas sueltas. Solo corre mientras hay nivel de ruido.
      var vhs = (function () {
        var cv = document.querySelector(".vhs-noise");
        var cx = cv && cv.getContext && cv.getContext("2d");
        var W = 0, H = 0, img = null, buf = null, level = 0, band = 0, running = false, burstUntil = 0, burstLv = 0.5, cur = "";
        var LEVELS = { surge: 0.32, crt: 0.28, nosignal: 0.17, glitch: 0.85 };
        function size() {
          W = Math.max(2, Math.ceil(cv.clientWidth / 3)); H = Math.max(2, Math.ceil(cv.clientHeight / 3));
          cv.width = W; cv.height = H;
          img = cx.createImageData(W, H); buf = new Uint32Array(img.data.buffer);
        }
        function frame() {
          if (!running) return;
          var lv = level;
          if (performance.now() < burstUntil) lv = Math.max(lv, burstLv);
          if (cur === "glitch") lv *= 0.55 + Math.random() * 0.7;
          if (lv <= 0.001) { cx.clearRect(0, 0, W, H); running = false; return; }
          band = (band + H * 0.013) % (H * 1.5);
          var by = band - H * 0.25, bh = H * 0.13;
          for (var y = 0; y < H; y++) {
            var inBand = y > by && y < by + bh;
            var burnt = Math.random() < 0.018;
            var ra = lv * (inBand ? 1.7 : 1);
            var o = y * W, shift = inBand ? (Math.random() * 60) | 0 : 0;
            for (var x = 0; x < W; x++) {
              var v = burnt ? 190 + Math.random() * 65 : Math.random() * 255;
              if (inBand) v = Math.min(255, v + shift);
              var a = ra * (burnt ? 230 : 160 + Math.random() * 95);
              if (a > 255) a = 255;
              buf[o + x] = (a << 24) | (v << 16) | (v << 8) | v;
            }
          }
          cx.putImageData(img, 0, 0);
          requestAnimationFrame(frame);
        }
        function start() {
          if (!cx || reduce) return;
          if (!running) { size(); running = true; requestAnimationFrame(frame); }
        }
        return {
          state: function (s) { cur = s; level = LEVELS[s] || 0; if (level > 0) start(); },
          burst: function (ms, lv) { burstUntil = performance.now() + ms; burstLv = lv || 0.5; start(); },
          resize: function () { if (running) size(); }
        };
      })();

      // ── En el estado final, cada pocos segundos la cinta da un tirón.
      var hitsOn = false;
      function tapeHits() {
        if (hitsOn || reduce) return;
        hitsOn = true;
        (function next() {
          setTimeout(function () {
            var fv = document.querySelector(".final-v");
            vhs.burst(150);
            if (fv) { fv.classList.add("vhs-hit"); setTimeout(function () { fv.classList.remove("vhs-hit"); }, 170); }
            next();
          }, 4500 + Math.random() * 4500);
        })();
      }

      // ── Dígitos que fallan: cada pocos segundos uno se apaga un instante.
      (function flicker() {
        setTimeout(function () {
          var all = document.querySelectorAll(".led-digit");
          var d = all[Math.floor(Math.random() * all.length)];
          if (d && !reduce && root.getAttribute("data-state") === "count") {
            d.classList.add("dying");
            setTimeout(function () { d.classList.remove("dying"); }, 70 + Math.random() * 180);
            if (Math.random() < 0.4) setTimeout(function () {
              d.classList.add("dying");
              setTimeout(function () { d.classList.remove("dying"); }, 60);
            }, 260);
          }
          flicker();
        }, 2500 + Math.random() * 4500);
      })();

      function render(ms) {
        var t = Math.max(0, Math.floor(ms / 1000));
        var v = {
          d: Math.min(99, Math.floor(t / 86400)),
          h: Math.floor(t % 86400 / 3600),
          m: Math.floor(t % 3600 / 60),
          s: t % 60
        };
        for (var k in v) {
          paint(units[k][0], Math.floor(v[k] / 10));
          paint(units[k][1], v[k] % 10);
        }
        // Texto para lectores de pantalla, solo cada minuto para no saturar.
        if (sr && v.s === 0 || sr && !sr.textContent) {
          sr.textContent = v.d + " días, " + v.h + " horas, " + v.m + " minutos";
        }
      }

      // Secuencia al llegar a cero, en clave VHS:
      // sobrecarga del reloj → apagado de tubo → NO SIGNAL (negro 1 s) →
      // PLAY + glitch → impacto de la V → texto (1 s después).
      function end() {
        if (ending) return;
        ending = true;
        clearTimeout(timer);
        render(0);
        root.removeAttribute("data-intro");
        root.setAttribute("data-anim", "");
        var steps = reduce
          ? [[0, "nosignal"], [1000, "v"], [2000, "final"]]
          : [[0, "surge"], [700, "crt"], [1000, "nosignal"], [2000, "glitch"], [2700, "v"], [3700, "final"]];
        steps.forEach(function (st) { setTimeout(function () { setState(st[1]); }, st[0]); });
      }

      function tick() {
        var left = TARGET - now();
        if (left <= 0) {
          // Si se entra ya pasada la fecha, el estado final va directo, sin secuencia.
          if (root.getAttribute("data-state") !== "final") end();
          return;
        }
        if (root.getAttribute("data-state") === "final" && !ending) setState("count");
        render(left);
        // Se alinea con el cambio de segundo real para que no dé saltos dobles.
        timer = setTimeout(tick, (left % 1000) + 20);
      }

      if (root.getAttribute("data-state") !== "final") {
        setState("count");
        // Entrada de película: fundido desde negro, enfoque y encendido del marcador
        if (!reduce) {
          root.setAttribute("data-intro", "");
          setTimeout(function () { root.removeAttribute("data-intro"); }, 3200);
        }
      }
      else { embers.start(false); tapeHits(); }
      tick();

      // iOS congela los temporizadores en segundo plano: al volver, se recalcula.
      document.addEventListener("visibilitychange", function () {
        if (!document.hidden && !ending) { clearTimeout(timer); tick(); }
      });
      window.addEventListener("pageshow", function (e) {
        if (e.persisted && !ending) { clearTimeout(timer); tick(); }
      });

      // Contraste con la hora del servidor. La cabecera Date va en segundos,
      // así que solo se corrige un desfase claro (> 2 s) para no empeorar un
      // reloj que ya va bien.
      try {
        var t0 = Date.now();
        fetch(location.pathname + "?t=" + t0, { method: "HEAD", cache: "no-store" }).then(function (r) {
          var t1 = Date.now();
          var server = Date.parse(r.headers.get("date"));
          if (isNaN(server)) return;
          var diff = server + 500 - (t0 + t1) / 2;
          if (Math.abs(diff) > 2000 && !ending) {
            offset = diff;
            clearTimeout(timer);
            tick();
          }
        }).catch(function () {});
      } catch (e) {}
    })();
  </script>
</body>
</html>

<style>
  @font-face { font-family: "BSP Helvetica"; src: url("/fonts/helvetica-neue/HelveticaNeueMedium.woff2") format("woff2"); font-weight: 500; font-style: normal; font-display: swap; }
  @font-face { font-family: "BSP Helvetica"; src: url("/fonts/helvetica-neue/HelveticaNeueBold.woff2") format("woff2"); font-weight: 700; font-style: normal; font-display: swap; }

  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  /* Sin 100vh: todo cuelga de position:fixed + inset:0, que en Safari de iPhone
     ocupa siempre la ventana visible, con o sin la barra del navegador. */
  html, body {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
    background: #000;
  }
  body {
    position: fixed;
    inset: 0;
    color: #E9E6E1;
    font-family: "BSP Helvetica", "Helvetica Neue", Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    -webkit-text-size-adjust: 100%;
    -webkit-tap-highlight-color: transparent;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    touch-action: manipulation;
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
  }

  .stage {
    position: fixed;
    inset: 0;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: #000;
  }

  /* ── Fondo ─────────────────────────────────────────── */
  .bg, .blackout, .grain, .final {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .bg {
    overflow: hidden;
    transition: opacity 0.5s ease;
    container-type: size;
    /* cámara en mano: deriva lenta, casi imperceptible */
    animation: handheld 17s ease-in-out infinite alternate;
  }
  @keyframes handheld {
    0% { transform: scale(1.012) translate3d(0, 0, 0) rotate(0deg); }
    25% { transform: scale(1.012) translate3d(0.3vmax, -0.22vmax, 0) rotate(0.12deg); }
    50% { transform: scale(1.012) translate3d(-0.24vmax, 0.16vmax, 0) rotate(-0.1deg); }
    75% { transform: scale(1.012) translate3d(0.18vmax, 0.28vmax, 0) rotate(0.08deg); }
    100% { transform: scale(1.012) translate3d(-0.28vmax, -0.12vmax, 0) rotate(-0.12deg); }
  }

  /* La escena cubre la pantalla como un object-fit: cover, pero además se
     acerca lo necesario para que el reloj ocupe buena parte del ancho.
     --g*: posición del cristal del reloj en la imagen, en %. */
  .scene {
    /* desplazamiento para que la caja del reloj (no la imagen) quede centrada */
    --cx: -52.27%;
    --zoom: 1.5;
    --gx: 33.333%; --gy: 46.006%; --gw: 37.611%; --gh: 7.632%;
    position: absolute;
    left: 50%;
    top: 50%;
    width: max(100cqw, 100cqh * 1122 / 1402, 100cqw * var(--zoom));
    aspect-ratio: 1122 / 1402;
    transform: translate(var(--cx), -50%) scale(1.03);
    animation: push 48s ease-in-out infinite alternate;
    will-change: transform;
  }
  @media (min-aspect-ratio: 1/1) {
    .scene {
      --cx: -50%;
      --zoom: 1.358;
      --gx: 39.224%; --gw: 21.553%;
      width: max(100cqw, 100cqh * 1958 / 1402, 100cqw * var(--zoom));
      aspect-ratio: 1958 / 1402;
    }
  }
  @keyframes push {
    to { transform: translate(var(--cx), -50.6%) scale(1.09); }
  }

  .scene-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Rojo contenido: la luz de la ambientación, pero sin saturar */
    filter: brightness(0.78) saturate(0.85) contrast(1.05);
  }

  /* V latente: la misma escena con la V, casi transparente */
  .scene-v {
    opacity: 0.07;
    animation: vbreath 11s ease-in-out infinite alternate;
  }
  @keyframes vbreath { from { opacity: 0.04; } to { opacity: 0.1; } }

  /* Cristal del reloj: se oscurece el de la foto y encima van los LED */
  .screen {
    position: absolute;
    left: var(--gx);
    top: var(--gy);
    width: var(--gw);
    height: var(--gh);
    container-type: size;
    display: grid;
    place-items: center;
    background: radial-gradient(ellipse at 50% 40%, rgba(12, 4, 3, 0.8), rgba(2, 1, 1, 0.92));
    border-radius: 2px;
    box-shadow:
      inset 0 2px 6px rgba(0, 0, 0, 0.95),
      inset 0 0 0 1px rgba(0, 0, 0, 0.7),
      0 0 14px rgba(200, 20, 10, 0.22);
    overflow: hidden;
  }
  /* Suciedad y reflejo del cristal, por encima de los dígitos */
  .screen::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(165deg, rgba(255, 230, 215, 0.07) 0%, transparent 40%),
      url("/images/halloween-v/cristal-sucio.webp") center / cover;
    opacity: 0.6;
    pointer-events: none;
  }

  /* Humo: textura propia repetible (humo.webp) que se desplaza en bucle */
  .bg-smoke {
    position: absolute;
    top: -20%; left: 0;
    width: calc(100% + 720px);
    height: 140%;
    background: url("/images/halloween-v/humo.webp") repeat 0 0 / 720px 720px;
    mix-blend-mode: screen;
    will-change: transform;
  }
  .bg-smoke--a { opacity: 0.12; animation: drift 70s linear infinite; }
  .bg-smoke--b {
    opacity: 0.08;
    background-size: 1080px 1080px;
    width: calc(100% + 1080px);
    animation: drift-b 110s linear infinite reverse;
  }
  @keyframes drift { to { transform: translate3d(-720px, 0, 0); } }
  @keyframes drift-b { to { transform: translate3d(-1080px, 0, 0); } }

  .bg-vignette {
    position: absolute;
    inset: 0;
    /* parpadeo de proyector: pequeñas caídas de exposición irregulares */
    animation: gate 6.5s steps(1, end) infinite;
    background:
      radial-gradient(ellipse 80% 70% at 50% 50%, transparent 35%, rgba(0, 0, 0, 0.7) 100%),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.4), transparent 25%, transparent 75%, rgba(0, 0, 0, 0.55));
  }

  /* Grano de película: una tesela que salta de posición a saltos */
  .grain {
    inset: -60px;
    background: url("/images/halloween-v/grano.webp") repeat 0 0 / 256px 256px;
    mix-blend-mode: overlay;
    opacity: 0.2;
    animation: grain 0.9s steps(1, end) infinite;
    z-index: 5;
  }
  @keyframes grain {
    0% { transform: translate3d(0, 0, 0); }
    16% { transform: translate3d(-37px, 21px, 0); }
    33% { transform: translate3d(19px, -44px, 0); }
    50% { transform: translate3d(-12px, 53px, 0); }
    66% { transform: translate3d(48px, 9px, 0); }
    83% { transform: translate3d(-51px, -27px, 0); }
  }


  /* ── Dígitos LED ───────────────────────────────────── */
  .led {
    /* Ancho de un dígito, relativo al cristal (.screen es el contenedor) */
    --dw: min(100cqw / 11.2, 100cqh / 2.55);
    --red: #D8190D;
    position: relative;
    transition: opacity 0.5s ease, filter 0.5s ease;
  }
  .led-face {
    display: flex;
    align-items: flex-start;
    gap: calc(var(--dw) * 0.16);
    /* Resplandor de los LED, aplicado una sola vez al conjunto */
    filter: drop-shadow(0 0 calc(var(--dw) * 0.07) rgba(210, 25, 12, 0.85)) drop-shadow(0 0 calc(var(--dw) * 0.3) rgba(180, 15, 8, 0.4));
    /* Tensión inestable: caídas de brillo muy de vez en cuando */
    animation: mains 13s steps(1, end) infinite;
  }
  @keyframes mains {
    0%, 71%, 72.6%, 74%, 100% { opacity: 1; }
    71.4% { opacity: 0.35; }
    71.9% { opacity: 0.85; }
    72.2% { opacity: 0.15; }
    73.2% { opacity: 0.7; }
  }
  .led-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--dw) * 0.26);
  }
  .led-digits { display: flex; gap: calc(var(--dw) * 0.14); }
  .led-digit {
    display: block;
    width: var(--dw);
    height: calc(var(--dw) * 5 / 3);
    overflow: visible;
  }
  .s { fill: rgba(150, 25, 18, 0.1); transition: fill 0.08s linear; }
  .s.on { fill: var(--red); }
  /* Un dígito que falla un instante (lo decide el script al azar) */
  .led-digit.dying .s.on { fill: rgba(216, 25, 13, 0.22); }

  .led-colon {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: calc(var(--dw) * 0.46);
    height: calc(var(--dw) * 5 / 3);
    padding: 0 calc(var(--dw) * 0.04);
  }
  .led-colon i {
    display: block;
    width: calc(var(--dw) * 0.15);
    height: calc(var(--dw) * 0.15);
    background: var(--red);
  }
  .led-label {
    font-size: max(6.5px, calc(var(--dw) * 0.21));
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.2em;
    text-indent: 0.2em; /* compensa el tracking para centrar bajo los dígitos */
    text-transform: uppercase;
    color: rgba(210, 40, 28, 0.6);
    white-space: nowrap;
  }

  /* ── Reloj grabado: números arañados en la placa de acero ── */
  /* La placa de esta variante es algo mayor que el cristal del LED */
  .scene--grabado { --gx: 33.155%; --gy: 45.506%; --gw: 38.324%; --gh: 8.488%; }
  @media (min-aspect-ratio: 1/1) {
    .scene--grabado { --gx: 39.122%; --gw: 21.961%; }
  }
  .scene--grabado .screen { background: none; box-shadow: none; overflow: visible; }
  .scene--grabado .screen::after { display: none; }
  .led--grabado .led-face {
    animation: none;
    /* Las ranuras sangran luz roja sobre el metal */
    filter: drop-shadow(0 0 calc(var(--dw) * 0.05) rgba(255, 40, 20, 0.55)) drop-shadow(0 0 calc(var(--dw) * 0.28) rgba(160, 10, 5, 0.5));
  }
  .scr-digit, .scr-colon { overflow: visible; }
  .scr-colon {
    display: block;
    width: calc(var(--dw) * 0.3);
    height: calc(var(--dw) * 5 / 3);
  }
  /* Sombra del surco (arriba a la izquierda), labio de acero en bruto y núcleo al rojo */
  .led--grabado :global(.sc-sh) { fill: rgba(0, 0, 0, 0.85); transform: translate(-0.8px, -1px); }
  .led--grabado :global(.sc-ed) { fill: #B8AA9E; opacity: 0.9; }
  .led--grabado :global(.sc-co) { fill: #FF2D14; animation: bleed 3.4s ease-in-out infinite alternate; }
  @keyframes bleed { from { opacity: 0.65; } to { opacity: 1; } }
  .scr-digit.fresh { animation: fresh 0.9s ease-out; }
  @keyframes fresh {
    from { filter: brightness(2.6) drop-shadow(0 0 3px #FF3A1A); }
    to { filter: none; }
  }
  .led--grabado .led-label {
    font-weight: 700;
    letter-spacing: 0.26em;
    text-indent: 0.26em;
    color: #B8AA9E;
    text-shadow: 0 0 0.45em rgba(255, 40, 20, 0.7);
    filter: url(#rasgado);
  }

  @keyframes gate {
    0%, 100% { opacity: 1; }
    13% { opacity: 0.9; } 14% { opacity: 1; }
    41% { opacity: 0.95; } 42% { opacity: 1; }
    77% { opacity: 0.88; } 78% { opacity: 0.97; } 79% { opacity: 1; }
  }

  /* ── Entrada de película ──────────────────────────── */
  :global([data-intro]) .blackout { animation: intro-black 2.2s cubic-bezier(0.4, 0, 0.2, 1) both; }
  :global([data-intro]) .scene-img:not(.scene-v) { animation: focus-pull 3s cubic-bezier(0.3, 0, 0.2, 1) both; }
  :global([data-intro]) .led { animation: power-on 1.5s steps(1, end) 1.2s both; }
  @keyframes intro-black { from { opacity: 1; } to { opacity: 0; } }
  @keyframes focus-pull {
    from { filter: blur(10px) brightness(0.25) saturate(0.6) contrast(1.05); }
    to { filter: brightness(0.78) saturate(0.85) contrast(1.05); }
  }
  /* el marcador arranca como un tubo: parpadea antes de quedarse fijo */
  @keyframes power-on {
    0% { opacity: 0; } 16% { opacity: 0.8; } 22% { opacity: 0; } 38% { opacity: 1; } 44% { opacity: 0.2; } 58%, 100% { opacity: 1; }
  }

  /* ── Capas VHS ─────────────────────────────────────── */
  .vhs-noise, .vhs-scan, .osd, .crt-dot {
    position: absolute;
    pointer-events: none;
  }
  .vhs-noise { inset: 0; width: 100%; height: 100%; z-index: 7; }
  .vhs-scan {
    inset: 0;
    z-index: 8;
    opacity: 0;
    background: repeating-linear-gradient(to bottom, rgba(0, 0, 0, 0.3) 0, rgba(0, 0, 0, 0.3) 1px, transparent 1px, transparent 3px);
    overflow: hidden;
  }
  /* Barra de tracking que rueda hacia abajo */
  .vhs-scan::after {
    content: "";
    position: absolute;
    left: 0; right: 0;
    top: 0;
    height: 16%;
    background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.07) 45%, rgba(255, 255, 255, 0.12) 50%, rgba(255, 255, 255, 0.07) 55%, transparent);
    animation: roll 2.6s linear infinite;
  }
  @keyframes roll { from { transform: translateY(-120%); } to { transform: translateY(720%); } }
  .crt-dot {
    left: 50%; top: 50%;
    width: 8px; height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 12px 4px rgba(255, 255, 255, 0.9), 0 0 40px 12px rgba(255, 60, 40, 0.5);
    opacity: 0;
    z-index: 9;
  }
  .osd {
    inset: 0;
    z-index: 9;
    visibility: hidden;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-weight: 700;
    line-height: 1;
    color: #EFEFEF;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    /* canales separados, como una cinta gastada */
    text-shadow: 2px 0 rgba(255, 0, 60, 0.75), -2px 0 rgba(0, 220, 255, 0.6), 0 0 10px rgba(255, 255, 255, 0.35);
  }
  .osd-ch, .osd-play {
    position: absolute;
    top: calc(env(safe-area-inset-top, 0px) + max(28px, 6vh));
    left: max(22px, 6vw);
    font-size: clamp(1.1rem, 5vw, 1.9rem);
    opacity: 0;
  }
  .osd-ns {
    position: absolute;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    font-size: clamp(1rem, 4.8vw, 1.7rem);
    letter-spacing: 0.3em;
    text-indent: 0.3em;
    white-space: nowrap;
    opacity: 0;
  }
  @keyframes osd-blink { 50% { opacity: 0.15; } }
  @keyframes osd-flicker {
    0% { opacity: 0; } 10% { opacity: 1; } 30% { opacity: 0.3; } 40%, 80% { opacity: 1; } 90%, 100% { opacity: 0; }
  }
  @keyframes jolt {
    0% { transform: translate(var(--cx), -50%) scale(1.03); filter: none; clip-path: none; }
    12% { transform: translate(calc(var(--cx) + 10px), -50%) scale(1.05) skewX(2deg); filter: brightness(1.5) saturate(1.5) contrast(1.2); }
    24% { transform: translate(calc(var(--cx) - 14px), -49%) scale(1.04); filter: brightness(0.6) contrast(1.6); clip-path: inset(30% 0 52% 0); }
    34% { transform: translate(calc(var(--cx) + 4px), -50%) scale(1.07) skewX(-3deg); filter: brightness(2) hue-rotate(-15deg) saturate(2); clip-path: none; }
    48% { transform: translate(calc(var(--cx) - 6px), -51%) scale(1.03); filter: brightness(0.8); clip-path: inset(0 0 60% 0); }
    60% { transform: translate(var(--cx), -50%) scale(1.06) skewX(4deg); filter: brightness(1.8) contrast(1.4); clip-path: none; }
    74% { transform: translate(calc(var(--cx) + 12px), -50%) scale(1.05); filter: brightness(0.5); clip-path: inset(55% 0 10% 0); }
    86%, 100% { transform: translate(var(--cx), -50%) scale(1.08); filter: brightness(2.4) saturate(1.8); clip-path: none; }
  }
  @keyframes surge-face {
    0% { filter: drop-shadow(0 0 4px #FF2A1C); }
    20% { opacity: 0.2; }
    30% { opacity: 1; filter: drop-shadow(4px 0 0 rgba(255, 0, 50, 0.9)) drop-shadow(-4px 0 0 rgba(0, 230, 255, 0.7)) drop-shadow(0 0 10px #FF2A1C); }
    45% { opacity: 0.4; }
    55% { opacity: 1; transform: translateX(3px); }
    70% { opacity: 0.1; }
    80%, 100% { opacity: 1; transform: none; filter: drop-shadow(6px 0 0 rgba(255, 0, 50, 0.9)) drop-shadow(-6px 0 0 rgba(0, 230, 255, 0.7)) brightness(1.8); }
  }
  @keyframes crt-off {
    0% { transform: scale(1, 1); filter: brightness(1); opacity: 1; }
    45% { transform: scale(1, 0.012); filter: brightness(5); opacity: 1; }
    75% { transform: scale(0.35, 0.006); filter: brightness(8); opacity: 1; }
    100% { transform: scale(0, 0.004); filter: brightness(10); opacity: 0; }
  }
  @keyframes crt-dot {
    0% { opacity: 0; transform: scale(1.6); }
    25% { opacity: 1; }
    100% { opacity: 0; transform: scale(0.2); }
  }

  /* ── Secuencia final ───────────────────────────────── */
  .blackout {
    background: #000;
    opacity: 0;
    z-index: 3;
  }
  .final {
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(1.2rem, 4vh, 2.4rem);
    visibility: hidden;
  }

  /* Contraluz rojo que late detrás de la V */
  .final-glow {
    position: absolute;
    left: 50%;
    top: 44%;
    width: min(150vw, 110vh);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, rgba(200, 20, 10, 0.34), rgba(120, 8, 4, 0.14) 45%, transparent 72%);
    opacity: 0;
    pointer-events: none;
  }

  .final-v {
    position: relative;
    width: min(78vw, 46vh, 32rem);
    aspect-ratio: 1;
    opacity: 0;
    margin: calc(min(78vw, 46vh, 32rem) * -0.06) 0; /* la imagen trae aire negro arriba y abajo */
  }

  /* HALLOWEEN FEST / 5º ANIVERSARIO, encima de la V */
  .final-kicker {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
  }
  /* Interletrado -80 (-0,08 em), como en el kit de marca */
  .fk-1 {
    font-size: clamp(2rem, 10vw, 3.6rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.08em;
    color: #EDE8E1;
    text-shadow: 0 0 0.4em rgba(255, 40, 25, 0.3);
  }
  .fk-2 {
    font-size: clamp(1.05rem, 5vw, 1.8rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.08em;
    color: rgba(235, 55, 38, 0.95);
  }
  .final-v img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    -webkit-mask-image: radial-gradient(closest-side, #000 50%, transparent 94%);
    mask-image: radial-gradient(closest-side, #000 50%, transparent 94%);
  }
  .final-v img:nth-child(n+2) { opacity: 0; }

  /* Brillo que recorre el metal de izquierda a derecha: una copia iluminada
     de la propia V, recortada por una franja que se desplaza. Lleva también
     la máscara radial de la V, así que nunca se ve el recuadro de la imagen. */
  .final-v img.final-sheen {
    opacity: 1;
    filter: brightness(3.4) saturate(1.1);
    mix-blend-mode: screen;
    pointer-events: none;
    -webkit-mask-image:
      linear-gradient(100deg, transparent 39%, rgba(0, 0, 0, 0.4) 45%, #000 50%, rgba(0, 0, 0, 0.4) 55%, transparent 61%),
      radial-gradient(closest-side, #000 50%, transparent 94%);
    -webkit-mask-size: 300% 100%, 100% 100%;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: 100% 0, 0 0;
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(100deg, transparent 39%, rgba(0, 0, 0, 0.4) 45%, #000 50%, rgba(0, 0, 0, 0.4) 55%, transparent 61%),
      radial-gradient(closest-side, #000 50%, transparent 94%);
    mask-size: 300% 100%, 100% 100%;
    mask-repeat: no-repeat;
    mask-position: 100% 0, 0 0;
    mask-composite: intersect;
  }

  .final-t {
    display: flex;
    align-items: center;
    gap: clamp(0.6rem, 2.6vw, 1.2rem);
    font-size: clamp(0.9rem, 4.1vw, 1.65rem);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    color: #EDE8E1;
    white-space: nowrap;
  }
  .final-words {
    display: flex;
    gap: 0.9em;
    letter-spacing: 0.42em;
    margin-right: -0.42em; /* el tracking de la última letra no descentra la frase */
  }
  .final-word { display: flex; }
  .l {
    display: inline-block;
    opacity: 0;
    text-shadow: 0 0 0.5em rgba(255, 40, 25, 0.35);
  }
  .final-rule {
    display: block;
    width: clamp(16px, 6vw, 84px);
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 45, 30, 0.9));
    transform: scaleX(0);
    transform-origin: right center;
  }
  .final-rule:last-child {
    background: linear-gradient(270deg, transparent, rgba(255, 45, 30, 0.9));
    transform-origin: left center;
  }

  /* Fecha bajo THE GAME BEGINS: aparece despacio, casi en susurro */
  .final-date {
    margin-top: calc(clamp(1.2rem, 4vh, 2.4rem) * -0.35);
    font-size: clamp(1.1rem, 5.2vw, 1.7rem);
