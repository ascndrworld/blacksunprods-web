  :global([data-state="glitch"]) .osd-play { opacity: 1; animation: osd-flicker 0.7s steps(1, end) both; }

  /* Líneas de barrido: fuertes durante la transición, casi invisibles al final */
  :global([data-state="surge"]) .vhs-scan,
  :global([data-state="crt"]) .vhs-scan { opacity: 0.7; }
  :global([data-state="nosignal"]) .vhs-scan { opacity: 0.85; }
  :global([data-state="glitch"]) .vhs-scan { opacity: 1; }
  :global([data-state="v"]) .vhs-scan,
  :global([data-state="final"]) .vhs-scan { opacity: 0.16; transition: opacity 1.5s ease; }

  :global([data-state="glitch"]) .final,
  :global([data-state="v"]) .final,
  :global([data-state="final"]) .final { visibility: visible; }

  /* glitch: PLAY, la estática revienta y la V asoma a trozos con los canales separados */
  :global([data-state="glitch"]) .final-v { opacity: 1; }
  :global([data-state="glitch"]) .final-v img:nth-child(1) { animation: glitch-main 0.7s steps(1, end) both; }
  :global([data-state="glitch"]) .final-v img:nth-child(2) { filter: sepia(1) saturate(8) hue-rotate(-30deg) brightness(1.3); mix-blend-mode: screen; animation: glitch-a 0.7s steps(1, end) both; }
  :global([data-state="glitch"]) .final-v img:nth-child(3) { filter: sepia(1) saturate(6) hue-rotate(150deg) brightness(1.4); mix-blend-mode: screen; animation: glitch-b 0.7s steps(1, end) both; }
  :global([data-state="glitch"]) .stage { animation: shake 0.7s steps(1, end) both; }

  /* Tirón de cinta en el estado final */
  .final-v.vhs-hit { translate: 5px 0; }
  .final-v.vhs-hit img:first-child { filter: drop-shadow(6px 0 0 rgba(255, 0, 50, 0.7)) drop-shadow(-6px 0 0 rgba(0, 220, 255, 0.55)); }

  /* v: impacto. La V cae, destello, haz de luz, sacudida; luego se acerca despacio */
  :global([data-state="v"]) .final-v,
  :global([data-state="final"]) .final-v {
    opacity: 1;
    animation: slam 1s cubic-bezier(0.16, 0.84, 0.24, 1) both, vpush 18s ease-out 1s forwards;
  }
  :global([data-state="v"]) .flash { animation: flash 0.9s ease-out both; }
  :global([data-state="v"]) .whip { animation: whip 0.5s cubic-bezier(0.45, 0, 0.75, 1) both; }
  :global([data-state="v"]) .stage { animation: impact 0.55s cubic-bezier(0.3, 0.6, 0.4, 1) both; }
  :global([data-state="v"]) .final-glow,
  :global([data-state="final"]) .final-glow { animation: glow-in 1.2s ease-out both, heartbeat 2.6s ease-in-out 1.2s infinite; }
  :global([data-state="v"]) .final-sheen,
  :global([data-state="final"]) .final-sheen { animation: sheen 7s ease-in-out 0.9s infinite; }

  :global([data-state="v"]) .final-kicker,
  :global([data-state="final"]) .final-kicker { animation: kicker 1.6s cubic-bezier(0.2, 0.8, 0.2, 1) 0.75s both; }

  /* final: THE GAME BEGINS — líneas que se abren y letras que se encienden */
  :global([data-state="final"]) .final-rule { animation: rule 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.15s both; }
  :global([data-state="final"]) .final-words { animation: track 2.4s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  :global([data-state="final"]) .l { animation: letter 1.1s linear calc(var(--i) * 60ms + 250ms) both; }
  :global([data-state="final"]) .final-date { animation: date-in 2.6s ease-out 1.9s both; }

  /* Quien entra ya pasada la fecha ve el estado final asentado, sin impacto */
  :global([data-state="final"]:not([data-anim])) .final-v { animation: vpush 18s ease-out forwards; }
  :global([data-state="final"]:not([data-anim])) .final-glow { animation: heartbeat 2.6s ease-in-out infinite; opacity: 1; }
  :global([data-state="final"]:not([data-anim])) .final-kicker { animation: none; opacity: 1; }
  :global([data-state="final"]:not([data-anim])) .final-rule { animation: none; transform: none; }
  :global([data-state="final"]:not([data-anim])) .final-words { animation: none; }
  :global([data-state="final"]:not([data-anim])) .l { animation: none; opacity: 1; }
  :global([data-state="final"]:not([data-anim])) .final-date { animation: none; opacity: 1; }

  @keyframes slam {
    0% { opacity: 0; transform: scale(1.5); filter: blur(16px) brightness(3.2); }
    30% { opacity: 1; transform: scale(0.965); filter: blur(0) brightness(1.8); }
    50% { transform: scale(1.012); filter: brightness(1.25); }
    70% { transform: scale(0.998); }
    100% { opacity: 1; transform: scale(1); filter: none; }
  }
  @keyframes vpush { from { transform: scale(1); } to { transform: scale(1.07); } }
  @keyframes flash {
    0% { opacity: 0; }
    12% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes whip {
    0% { opacity: 1; transform: translate3d(0, -110%, 0); }
    30% { transform: translate3d(-6px, 60%, 0); }
    55% { transform: translate3d(5px, 200%, 0); }
    85% { opacity: 1; }
    100% { opacity: 0; transform: translate3d(0, 420%, 0); }
  }
  @keyframes impact {
    0% { transform: translate3d(0, 0, 0); }
    10% { transform: translate3d(0, 9px, 0); }
    22% { transform: translate3d(-6px, -5px, 0); }
    36% { transform: translate3d(5px, 3px, 0); }
    52% { transform: translate3d(-3px, -2px, 0); }
    70% { transform: translate3d(1px, 1px, 0); }
    100% { transform: none; }
  }
  @keyframes glow-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes heartbeat {
    0%, 100% { opacity: 0.75; transform: translate(-50%, -50%) scale(1); }
    12% { opacity: 1; transform: translate(-50%, -50%) scale(1.05); }
    22% { opacity: 0.82; transform: translate(-50%, -50%) scale(1.01); }
    32% { opacity: 1; transform: translate(-50%, -50%) scale(1.07); }
    55% { opacity: 0.75; transform: translate(-50%, -50%) scale(1); }
  }
  /* 100% = franja fuera por la izquierda; 0% = fuera por la derecha */
  @keyframes sheen {
    0% { -webkit-mask-position: 100% 0, 0 0; mask-position: 100% 0, 0 0; }
    30%, 100% { -webkit-mask-position: 0% 0, 0 0; mask-position: 0% 0, 0 0; }
  }
  @keyframes date-in {
