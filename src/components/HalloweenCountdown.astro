    to { opacity: 1; transform: none; filter: none; }
  }
  @keyframes rule { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes track {
    from { letter-spacing: 1.1em; margin-right: -1.1em; }
    to { letter-spacing: 0.42em; margin-right: -0.42em; }
  }
  /* Cada letra arranca como un fluorescente: parpadea en rojo y se asienta */
  @keyframes letter {
    0% { opacity: 0; color: #FF2A1C; text-shadow: 0 0 0.6em rgba(255, 40, 25, 0.9); }
