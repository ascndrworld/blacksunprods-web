    opacity: 0;
  }

  .embers {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Destello del impacto y latigazo VHS */
  .flash, .whip {
    position: absolute;
    pointer-events: none;
    z-index: 6;
    opacity: 0;
  }
  .flash {
    inset: 0;
    background: radial-gradient(circle at 50% 44%, rgba(255, 238, 225, 0.95), rgba(230, 40, 20, 0.6) 26%, rgba(90, 0, 0, 0.3) 52%, transparent 75%);
    mix-blend-mode: screen;
  }
  /* Franja de estática y tracking que barre la pantalla en el impacto:
     dentro de ella la imagen se quema y pierde color, como una cinta que salta */
  .whip {
    left: 0;
    right: 0;
    top: 0;
    height: 24%;
    background:
      repeating-linear-gradient(to bottom, rgba(255, 255, 255, 0.1) 0, rgba(255, 255, 255, 0.1) 1px, transparent 1px, transparent 3px),
      url("/images/halloween-v/grano.webp") repeat 0 0 / 150px 150px;
    background-blend-mode: normal;
    mix-blend-mode: overlay;
    -webkit-backdrop-filter: brightness(1.35) contrast(1.25) saturate(0.35) hue-rotate(-8deg);
    backdrop-filter: brightness(1.35) contrast(1.25) saturate(0.35) hue-rotate(-8deg);
    transform: translateY(-110%);
  }

  /* surge: el reloj se sobrecarga y la señal se rompe */
  :global([data-state="surge"]) .scene { animation: jolt 0.7s steps(1, end) both; }
  :global([data-state="surge"]) .led:not(.led--grabado) .s { fill: var(--red); }
  :global([data-state="surge"]) .led-face { animation: surge-face 0.7s steps(1, end) both; }
  :global([data-state="surge"]) .led--grabado :global(.sc-co) { fill: #FFF3EE; }
  :global([data-state="surge"]) .led--grabado :global(.sc-ed) { fill: #FFD2C4; }

  /* crt: el tubo se apaga — la imagen se aplasta en una línea y luego en un punto */
  :global([data-state="crt"]) .bg { animation: crt-off 0.3s cubic-bezier(0.6, 0, 0.9, 0.4) both; }
  :global([data-state="crt"]) .crt-dot { animation: crt-dot 0.55s ease-out 0.18s both; }

  /* nosignal: negro 1 s, con nieve tenue y NO SIGNAL */
  :global([data-state="nosignal"]) .bg,
  :global([data-state="glitch"]) .bg,
  :global([data-state="v"]) .bg,
  :global([data-state="final"]) .bg { opacity: 0; visibility: hidden; }
