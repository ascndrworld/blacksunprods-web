---
import Layout from "../../layouts/Layout.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { SITE, absUrl } from "../../config/site.mjs";

// PENDIENTE: añadir fotos/vídeos, identidad visual y fechas cuando existan.
const formatos = [
  { name: "Verano", desc: "Beach club y open air: tardes y noches al aire libre." },
  { name: "Invierno", desc: "Formato clubbing en sala." },
];
const sonido = ["Reguetón antiguo", "Latin house"];
---

<Layout
  title={`Bendito Castigo — Concepto propio · ${SITE.name}`}
  description="Bendito Castigo, concepto musical propio de Black Sun Prods: reguetón antiguo y latin house en formato beach club y open air en verano, y clubbing en invierno."
  canonical={absUrl("/proyectos/bendito-castigo")}
>

<main class="bc">
  <section class="bc-hero">
    <p class="bc-cat">Concepto propio · En desarrollo</p>
    <h1 class="bc-title">bendito<br/>castigo</h1>
    <p class="bc-desc">Un concepto musical con identidad lifestyle y comercial, pensado para funcionar todo el año: open air en verano, club en invierno.</p>
  </section>

  <section class="bc-grid">
    <div class="bc-block">
      <h2>Sonido</h2>
      <ul class="bc-tags">{sonido.map((s) => <li>{s}</li>)}</ul>
    </div>
    {formatos.map((f) => (
      <div class="bc-block">
        <h2>{f.name}</h2>
        <p>{f.desc}</p>
      </div>
    ))}
  </section>

  <section class="bc-cta">
    <p>¿Tienes una sala, un recinto o una terraza para Bendito Castigo?</p>
    <div class="bc-links">
      <a class="bc-btn" href="/contacto?tipo=sala">Hablemos</a>
      <a class="bc-back" href="/proyectos">Volver a proyectos</a>
    </div>
  </section>
</main>

<SiteFooter />

<style>
  .bc { background: #000; color: #F7EFDB; font-family: "Montserrat", sans-serif; }
  .bc-hero { min-height: 80vh; min-height: 80dvh; display: flex; flex-direction: column; justify-content: flex-end; padding: 160px clamp(20px, 5vw, 88px) clamp(56px, 8vw, 110px); }
  .bc-cat { font-size: 11px; letter-spacing: .32em; text-transform: uppercase; color: rgba(247,239,219,.55); margin: 0 0 22px; }
  .bc-title { font-size: clamp(64px, 14vw, 220px); font-weight: 800; font-style: italic; letter-spacing: -.05em; line-height: .85; margin: 0 0 32px; }
  .bc-desc { font-size: clamp(16px, 1.4vw, 20px); line-height: 1.6; color: rgba(247,239,219,.7); max-width: 52ch; margin: 0; }

  .bc-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid rgba(247,239,219,.12); border-bottom: 1px solid rgba(247,239,219,.12); }
  .bc-block { padding: clamp(32px, 4vw, 56px) clamp(20px, 3vw, 48px); border-left: 1px solid rgba(247,239,219,.12); }
  .bc-block:first-child { border-left: none; padding-left: clamp(20px, 5vw, 88px); }
  .bc-block h2 { font-size: 12px; letter-spacing: .24em; text-transform: uppercase; color: rgba(247,239,219,.5); font-weight: 500; margin: 0 0 18px; }
  .bc-block p { font-size: clamp(18px, 1.6vw, 24px); font-weight: 700; line-height: 1.35; margin: 0; }
  .bc-tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .bc-tags li { font-size: 15px; padding: 9px 16px; border: 1px solid rgba(247,239,219,.25); border-radius: 999px; }

  .bc-cta { text-align: center; padding: clamp(80px, 10vw, 140px) 20px; }
  .bc-cta p { font-size: clamp(22px, 2.6vw, 36px); font-weight: 800; letter-spacing: -.02em; line-height: 1.2; max-width: 24ch; margin: 0 auto 36px; }
  .bc-links { display: flex; flex-direction: column; align-items: center; gap: 28px; }
  .bc-btn { font-size: 14px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: #000; background: #F7EFDB; border: 2px solid #F7EFDB; padding: 16px 40px; text-decoration: none; transition: background .25s, color .25s; }
  .bc-btn:hover { background: transparent; color: #F7EFDB; }
  .bc-back { font-size: 12px; letter-spacing: .28em; text-transform: uppercase; color: rgba(247,239,219,.7); text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 4px; }

  @media (max-width: 768px) {
    .bc-grid { grid-template-columns: 1fr; }
    .bc-block, .bc-block:first-child { border-left: none; padding: 32px 20px; }
    .bc-block + .bc-block { border-top: 1px solid rgba(247,239,219,.12); }
  }
</style>

</Layout>
