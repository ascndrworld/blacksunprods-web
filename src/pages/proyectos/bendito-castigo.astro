---
import Layout from "../../layouts/Layout.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { SITE, absUrl } from "../../config/site.mjs";

// PENDIENTE: añadir fotos/vídeos del directo y fechas cuando existan.
const formatos = [
  { name: "Verano", desc: "Beach club y open air: tardes y noches al aire libre." },
  { name: "Invierno", desc: "Formato clubbing en sala." },
];
const sonido = ["Reguetón", "Latin house"];
// Mockups de la identidad visual (4:5)
const identidad = [
  { src: "/images/bendito-castigo/cartel-beach-club.webp", alt: "Cartel de Bendito Castigo en la pared de un beach club al atardecer" },
  { src: "/images/bendito-castigo/entradas-pulseras-acreditaciones.webp", alt: "Entrada, pulseras VIP y general, tarjeta de acceso y acreditación backstage de Bendito Castigo" },
  { src: "/images/bendito-castigo/barra-carta-cocteles.webp", alt: "Vasos, botella, posavasos y carta de cócteles de Bendito Castigo en la barra" },
];
---

<Layout
  title={`Bendito Castigo — Concepto propio · ${SITE.name}`}
  description="Bendito Castigo, concepto musical propio de Black Sun Prods: reguetón antiguo y latin house en formato beach club y open air en verano, y clubbing en invierno."
  canonical={absUrl("/proyectos/bendito-castigo")}
  ogImage={absUrl("/images/bendito-castigo/portada-beach-club-atardecer.webp")}
  ogImageAlt="Público al atardecer en un beach club, con la luna de Bendito Castigo sobre la cabina del DJ"
>

<Fragment slot="head">
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Inicio", "item": absUrl("/") },
          { "@type": "ListItem", "position": 2, "name": "Proyectos", "item": absUrl("/proyectos") },
          { "@type": "ListItem", "position": 3, "name": "Bendito Castigo", "item": absUrl("/proyectos/bendito-castigo") }
        ]
      },
      {
        "@type": "CreativeWork",
        "name": "Bendito Castigo — Concepto musical propio",
        "description": "Concepto musical propio de Black Sun Prods: reguetón y latin house en formato beach club y open air en verano, y clubbing en sala en invierno.",
        "url": absUrl("/proyectos/bendito-castigo"),
        "creator": { "@type": "Organization", "name": SITE.name, "url": SITE.url },
        "keywords": ["concepto musical", "reguetón", "latin house", "beach club", "Jaén"],
        "inLanguage": "es-ES"
      }
    ]
  })} />
</Fragment>

<main class="bc">
  <section class="bc-hero">
    <img class="bc-hero-img" src="/images/bendito-castigo/portada-beach-club-atardecer.webp" alt="Público al atardecer en un beach club entre palmeras, con la luna de Bendito Castigo iluminada sobre la cabina del DJ" width="1672" height="941" fetchpriority="high"/>
    <div class="bc-hero-overlay" aria-hidden="true"></div>
    <div class="bc-hero-text">
      <p class="bc-cat">Concepto propio · En desarrollo</p>
      <h1 class="bc-title">Bendito Castigo</h1>
      <p class="bc-desc">Un concepto musical con identidad lifestyle y comercial, pensado para funcionar todo el año: open air en verano, club en invierno.</p>
    </div>
  </section>

  <section class="bc-grid">
    <div class="bc-block">
      <h2>Sonido</h2>
      <ul class="bc-tags">{sonido.map((s) => <li>{s}</li>)}</ul>
    </div>
    {formatos.map((f) => (
      <div class="bc-block">
        <h2>{f.name}</h2>
        <p>{f.desc}</p>
      </div>
    ))}
  </section>

  <section class="bc-id" aria-labelledby="bcIdTitle">
    <div class="bc-id-head" data-reveal>
      <h2 id="bcIdTitle">Identidad visual</h2>
      <p>Cartelería, acreditaciones y barra con una misma imagen: la luna y la estrella, y la paleta de un atardecer en la playa.</p>
    </div>
    <ul class="bc-gallery">
      {identidad.map((img) => (
        <li data-reveal><img src={img.src} alt={img.alt} width="1122" height="1402" loading="lazy"/></li>
      ))}
    </ul>
  </section>

  <section class="bc-cta">
    <p>¿Tienes una sala, un recinto o una terraza para Bendito Castigo?</p>
    <div class="bc-links">
      <a class="bc-btn" href="/contacto?tipo=sala">Hablemos</a>
      <a class="bc-back" href="/proyectos">Volver a proyectos</a>
    </div>
  </section>
</main>

<SiteFooter />

<style>
  .bc { background: #000; color: #F3F3F0; font-family: "Montserrat", sans-serif; }
  /* svh y no dvh: con dvh la foto se reescala en móvil cada vez que la barra del navegador aparece o se oculta al deslizar */
  .bc-hero { position: relative; overflow: hidden; min-height: 100vh; min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end; padding: 160px clamp(20px, 5vw, 88px) clamp(56px, 8vw, 110px); }
  /* Foto apaisada: el lado izquierdo ya es negro y deja respirar al título */
  .bc-hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 45%; }
  .bc-hero-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.5) 0%, rgba(0,0,0,.1) 35%, rgba(0,0,0,.75) 100%); }
  .bc-hero-text { position: relative; }
  .bc-cat { font-size: 11px; letter-spacing: .32em; text-transform: uppercase; color: rgba(243, 243, 240,.8); margin: 0 0 22px; }
  .bc-title { font-size: clamp(52px, 8.4vw, 120px); font-weight: 800; letter-spacing: -.05em; line-height: .85; margin: 0 0 32px; }
  .bc-desc { font-size: clamp(16px, 1.4vw, 20px); line-height: 1.6; color: rgba(243, 243, 240,.85); max-width: 52ch; margin: 0; }

  .bc-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid rgba(243, 243, 240,.12); border-bottom: 1px solid rgba(243, 243, 240,.12); }
  .bc-block { padding: clamp(32px, 4vw, 56px) clamp(20px, 3vw, 48px); border-left: 1px solid rgba(243, 243, 240,.12); }
  .bc-block:first-child { border-left: none; padding-left: clamp(20px, 5vw, 88px); }
  .bc-block h2 { font-size: 12px; letter-spacing: .24em; text-transform: uppercase; color: rgba(243, 243, 240,.5); font-weight: 500; margin: 0 0 18px; }
  .bc-block p { font-size: clamp(18px, 1.6vw, 24px); font-weight: 700; line-height: 1.35; margin: 0; }
  .bc-tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .bc-tags li { font-size: 15px; padding: 9px 16px; border: 1px solid rgba(243, 243, 240,.25); border-radius: 999px; }


  .bc-id { padding: clamp(64px, 8vw, 120px) clamp(20px, 5vw, 88px) 0; }
  .bc-id-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: clamp(24px, 5vw, 88px); align-items: end; margin: 0 0 clamp(32px, 4vw, 56px); }
  .bc-id-head h2 { font-size: clamp(32px, 4vw, 56px); font-weight: 800; letter-spacing: -.03em; line-height: 1; margin: 0; }
  .bc-id-head p { font-size: clamp(15px, 1.2vw, 17px); line-height: 1.7; color: rgba(243, 243, 240,.6); max-width: 48ch; margin: 0; }
  .bc-gallery { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(8px, 1vw, 16px); }
  .bc-gallery li { overflow: hidden; aspect-ratio: 4 / 5; background: #0d0d0d; }
  .bc-gallery img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s cubic-bezier(.25,.46,.45,.94); }
  @media (hover: hover) {
    .bc-gallery li:hover img { transform: scale(1.04); }
  }

  .bc-cta { text-align: center; padding: clamp(80px, 10vw, 140px) 20px; }
  .bc-cta p { font-size: clamp(22px, 2.6vw, 36px); font-weight: 800; letter-spacing: -.02em; line-height: 1.2; max-width: 24ch; margin: 0 auto 36px; }
  .bc-links { display: flex; flex-direction: column; align-items: center; gap: 28px; }
  .bc-btn { font-size: 14px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: #000; background: #F3F3F0; border: 2px solid #F3F3F0; padding: 16px 40px; text-decoration: none; transition: background .25s, color .25s; }
  .bc-btn:hover { background: transparent; color: #F3F3F0; }
  .bc-back { font-size: 12px; letter-spacing: .28em; text-transform: uppercase; color: rgba(243, 243, 240,.7); text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 4px; }

  @media (max-width: 768px) {
    /* El nombre va en una línea: el cuerpo se ajusta al ancho de la pantalla */
    .bc-title { font-size: clamp(30px, 10.5vw, 52px); }
    /* En vertical se encuadra por la cabina del DJ y la luna */
    .bc-hero-img { object-position: 96% center; }
    .bc-grid { grid-template-columns: 1fr; }
    .bc-block, .bc-block:first-child { border-left: none; padding: 32px 20px; }
    .bc-block + .bc-block { border-top: 1px solid rgba(243, 243, 240,.12); }
    .bc-id-head { grid-template-columns: 1fr; align-items: start; }
    .bc-gallery { grid-template-columns: 1fr; }
  }
</style>

</Layout>


