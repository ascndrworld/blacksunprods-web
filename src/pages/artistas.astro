---
import Layout from "../layouts/Layout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SITE, absUrl, hasWhatsapp } from "../config/site.mjs";

// Puerta de entrada para el otro lado del escenario: grupos, orquestas, DJs y
// animadores que buscan fechas. Las propuestas llegan por /api/contacto con
// clientType "artista", que cambia el aviso (no es un cliente al que vender).
//
// REVISAR con Francisco: la página NO habla de comisiones, exclusividad ni
// cachés, a propósito. Si se trabaja como agencia de booking (representación
// con porcentaje) hay que decirlo aquí y en la FAQ antes de que lo pregunten.

// Los valores viajan al aviso y a Airtable como "Tipo de evento".
const disciplinas = [
  { value: "Grupo o banda", name: "Grupos y bandas", desc: "Directo propio o versiones, de pop y rock a flamenco, indie o metal." },
  { value: "Orquesta", name: "Orquestas", desc: "Repertorio de verbena y baile para fiestas patronales y ferias." },
  { value: "DJ", name: "DJs", desc: "Sesiones de cabina para noches temáticas, festivales y fiestas de pueblo." },
  { value: "Animación o espectáculo", name: "Animación y espectáculos", desc: "Infantil, pasacalles, charangas, humor, magia o espectáculos de calle." },
];

const vias = [
  {
    tag: "Fechas",
    name: "Te metemos en cartel",
    desc: "Ayuntamientos, salas y promotores nos encargan sus fiestas, festivales y noches, y somos nosotros quienes elegimos a los artistas. Si tu propuesta encaja, entras en la lista a la que acudimos cada vez que montamos un cartel.",
  },
  {
    tag: "Tu evento",
    name: "Producimos tu propio bolo",
    desc: "Presentación de disco, concierto en solitario, aniversario de la banda o una fiesta con tu nombre. Buscamos el espacio, ponemos la técnica, la venta de entradas y la seguridad, y llevamos la noche.",
  },
  {
    tag: "Técnica",
    name: "Solo el sonido y la luz",
    desc: "Si la fecha ya la tienes y lo que falta es el equipo, alquilamos y operamos el rider de sonido e iluminación, con técnico durante el directo.",
    link: { href: "/sonido-e-iluminacion", text: "Ver los montajes →" },
  },
];

const pasos = [
  { name: "Nos mandas tu propuesta", desc: "Quién sois, qué tocáis y dónde podemos veros en directo. Con un vídeo nos basta para empezar." },
  { name: "La escuchamos", desc: "Vemos el directo, el formato y lo que necesitáis para tocar. Si falta algo, te lo pedimos." },
  { name: "Te proponemos", desc: "Cuando haya un evento que os encaje, te escribimos con fecha, sitio y condiciones. Si querías producir el tuyo, te mandamos presupuesto." },
  { name: "Llegas y tocas", desc: "Horarios, prueba de sonido y coordinación los llevamos nosotros. Vosotros, a lo vuestro." },
];

const material = [
  "Un vídeo en directo (YouTube, Instagram o un enlace de descarga)",
  "Redes y dónde escucharos (Spotify, SoundCloud, web…)",
  "Formato: cuántos sois y cuánto dura el show",
  "Desde dónde os movéis",
  "Rider técnico, si lo tenéis (si no, lo hacemos nosotros)",
];

// REVISAR con Francisco: son compromisos (no cobrar por escuchar, cartera,
// tiempo de respuesta). Redactados a partir de cómo trabaja hoy la productora.
const faq = [
  {
    q: "¿Cuesta algo mandaros una propuesta?",
    a: "No. Mandarnos vuestro material y que lo escuchemos es gratis y no os compromete a nada.",
  },
  {
    q: "¿Qué estilos buscáis?",
    a: "De todo. Lo que programamos depende de quién nos encarga el evento: unas fiestas patronales piden orquesta, una noche temática pide DJ y un festival de verano puede pedir bandas. Por eso nos interesa conocer a artistas de cualquier estilo.",
  },
  {
    q: "¿Y si ahora mismo no encajamos en nada?",
    a: "Os guardamos en cartera. Muchas veces el cartel se cierra semanas después de recibir una propuesta, cuando aparece el evento que pide justo ese formato.",
  },
  {
    q: "¿Hace falta tener equipo de sonido o rider técnico?",
    a: "No. La técnica de los eventos que producimos la ponemos nosotros. Si tenéis rider lo respetamos, y si no, lo escribimos con vosotros.",
  },
  {
    q: "¿En qué zona trabajáis?",
    a: "Sobre todo en la provincia de Jaén y en el resto de Andalucía. Si os movéis desde más lejos, decídnoslo igualmente.",
  },
  {
    q: "¿Podéis organizarnos nuestro propio concierto?",
    a: "Sí. Si queréis presentar disco, celebrar un aniversario o montar vuestra propia fiesta, buscamos el sitio y producimos el evento entero: técnica, entradas, seguridad y la operación de la noche.",
  },
];
---

<Layout
  title={`Artistas, grupos y DJs: actuar en Jaén | ${SITE.name}`}
  description="¿Tienes grupo, orquesta, sesión de DJ o espectáculo de animación y buscas fechas? Programamos fiestas, festivales y noches en Jaén y Andalucía. Mándanos tu propuesta."
  canonical={absUrl("/artistas")}
>

<Fragment slot="head">
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Inicio", "item": absUrl("/") },
          { "@type": "ListItem", "position": 2, "name": "Artistas", "item": absUrl("/artistas") }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": faq.map((item) => ({
          "@type": "Question",
          "name": item.q,
          "acceptedAnswer": { "@type": "Answer", "text": item.a }
        }))
      },
      {
        "@type": "Service",
        "name": "Programación y producción para artistas",
        "serviceType": "Contratación de artistas y producción de conciertos",
        "description": "Programación de grupos, orquestas, DJs y animación en fiestas, festivales y salas de Jaén y Andalucía, y producción de conciertos propios de artistas.",
        "url": absUrl("/artistas"),
        "provider": { "@type": "LocalBusiness", "name": SITE.name, "url": SITE.url },
        "areaServed": SITE.business.areaServed.map((a) => ({ "@type": "AdministrativeArea", "name": a })),
        "audience": { "@type": "Audience", "audienceType": "Grupos de música, orquestas, DJs y animadores" },
        "inLanguage": "es-ES"
      }
    ]
  })} />
</Fragment>

<main class="ar">

  <section class="ar-hero">
    <div class="ar-hero-content">
      <h1 class="ar-h1">
        <span class="ar-eyebrow">Para artistas, grupos y DJs</span>
        <span class="ar-title">Tú pones<br/>el directo.<br/>Nosotros,<br/>las fechas.</span>
      </h1>
      <p class="ar-sub">¿Tienes grupo, orquesta, sesión de DJ o espectáculo de animación y buscas dónde actuar? Producimos fiestas, festivales y noches en Jaén y Andalucía, y los carteles los montamos nosotros. Cuéntanos quién eres.</p>
      <a class="ar-btn ar-btn--solid" href="#propuesta">Mandar propuesta</a>
    </div>
    <div class="ar-hero-media">
      <img src="/images/halloween-fest/artista-en-directo.webp" alt="Artista cantando en directo junto a la cabina, con un haz de luz verde al fondo" width="1333" height="2000" fetchpriority="high"/>
    </div>
  </section>

  <section class="ar-section">
    <div class="ar-head">
      <span class="ar-kicker">A QUIÉN BUSCAMOS</span>
      <h2 class="ar-h2">Si te subes a un escenario, nos interesa</h2>
    </div>
    <ul class="ar-formats">
      {disciplinas.map((d) => (
        <li data-reveal>
          <h3>{d.name}</h3>
          <p>{d.desc}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="ar-section ar-section--line">
    <div class="ar-head">
      <span class="ar-kicker">QUÉ PODEMOS HACER POR TI</span>
      <h2 class="ar-h2">Tres maneras de trabajar juntos</h2>
    </div>
    <div class="ar-ways">
      {vias.map((v, i) => (
        <article class="ar-way" data-reveal>
          <span class="ar-way-tag">{String(i + 1).padStart(2, "0")} · {v.tag}</span>
          <h3>{v.name}</h3>
          <p>{v.desc}</p>
          {v.link && <a class="ar-link" href={v.link.href}>{v.link.text}</a>}
        </article>
      ))}
    </div>
  </section>

  <section class="ar-section ar-section--line">
    <div class="ar-head">
      <span class="ar-kicker">CÓMO FUNCIONA</span>
      <h2 class="ar-h2">De la propuesta al escenario</h2>
    </div>
    <ol class="ar-steps">
      {pasos.map((p, i) => (
        <li data-reveal>
          <span class="ar-step-num">{String(i + 1).padStart(2, "0")}</span>
          <h3>{p.name}</h3>
          <p>{p.desc}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="ar-proof">
    <img src="/images/halloween-fest/escenario-truss-pantalla-led.webp" alt="Escenario de Halloween Fest con truss, focos y pantalla LED visto desde la pista" width="1443" height="2000" loading="lazy"/>
    <div class="ar-proof-text">
      <span class="ar-kicker">DÓNDE TOCARÍAS</span>
      <h2 class="ar-h2">Noches de 600 personas</h2>
      <p>Llevamos ocho noches producidas en la caseta municipal de Los Villares, con 600 a 700 personas cada una: cuatro ediciones de <a href="/proyectos/halloween-fest">Halloween Fest</a> y las Nochebuenas y Nocheviejas de <a href="/proyectos/conclave-x-la-caseta">Cónclave x La Caseta</a>. Escenario, técnica y público, y un equipo que cuida a quien sube a tocar.</p>
      <a class="ar-link" href="/proyectos">Ver nuestros proyectos →</a>
    </div>
  </section>

  <section class="ar-section ar-form-section" id="propuesta">
    <div class="ar-form-intro">
      <span class="ar-kicker">MÁNDANOS TU PROPUESTA</span>
      <h2 class="ar-h2">Cuéntanos<br/>quién eres</h2>
      <p class="ar-lead">Con esto nos basta para escucharte:</p>
      <ul class="ar-checklist">
        {material.map((m) => <li>{m}</li>)}
      </ul>
      <p class="ar-direct">
        ¿Prefieres mandarlo directo? Escribe a <a href={`mailto:${SITE.email}?subject=Propuesta%20de%20artista`}>{SITE.email}</a>
        {hasWhatsapp() && (<> o por <a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a></>)}.
      </p>
    </div>

    <div class="ar-form-wrap" id="arFormWrap">
      <form class="ar-form" id="arForm" novalidate>
        <div class="ar-row">
          <div class="ar-field">
            <label for="arArtista">Nombre artístico</label>
            <input id="arArtista" name="artista" type="text" autocomplete="off" placeholder="Grupo, orquesta, DJ…" required/>
          </div>
          <div class="ar-field">
            <label for="arNombre">Persona de contacto</label>
            <input id="arNombre" name="nombre" type="text" autocomplete="name" required/>
          </div>
        </div>

        <div class="ar-row">
          <div class="ar-field">
            <label for="arEmail">Email</label>
            <input id="arEmail" name="email" type="email" autocomplete="email" required/>
          </div>
          <div class="ar-field">
            <label for="arTelefono">Teléfono <span class="ar-opt">opcional</span></label>
            <input id="arTelefono" name="telefono" type="tel" autocomplete="tel" inputmode="tel" placeholder="Llamada o WhatsApp"/>
          </div>
        </div>

        <div class="ar-row">
          <div class="ar-field">
            <label for="arDisciplina">¿Qué sois?</label>
            <select id="arDisciplina" name="disciplina">
              <option value="">Selecciona una opción</option>
              {disciplinas.map((d) => <option value={d.value}>{d.name}</option>)}
              <option value="Otro">Otro</option>
            </select>
          </div>
          <div class="ar-field">
            <label for="arBusca">¿Qué buscáis?</label>
            <select id="arBusca" name="busca">
              <option value="">Selecciona una opción</option>
              <option value="Fechas en vuestros eventos">Fechas en vuestros eventos</option>
              <option value="Producir nuestro propio evento">Producir nuestro propio evento</option>
              <option value="Solo sonido e iluminación">Solo sonido e iluminación</option>
            </select>
          </div>
        </div>

        <div class="ar-row">
          <div class="ar-field">
            <label for="arEstilo">Estilo o repertorio</label>
            <input id="arEstilo" name="estilo" type="text" autocomplete="off" placeholder="Rock, versiones, techno, infantil…"/>
          </div>
          <div class="ar-field">
            <label for="arBase">Desde dónde os movéis</label>
            <input id="arBase" name="base" type="text" autocomplete="off" placeholder="Ej. Jaén, Granada…"/>
          </div>
        </div>

        <div class="ar-field">
          <label for="arEnlaces">Enlaces</label>
          <textarea id="arEnlaces" name="enlaces" rows="3" maxlength="600" placeholder="Vídeo en directo, Instagram, Spotify, web…"></textarea>
        </div>

        <div class="ar-field">
          <label for="arConsulta">Cuéntanos más <span class="ar-opt">opcional</span></label>
          <textarea id="arConsulta" name="consulta" rows="4" maxlength="600" placeholder="Cuántos sois, duración del show, fechas libres, caché orientativo…"></textarea>
        </div>

        <input type="text" id="arWebsite" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="ar-hp"/>

        <button type="submit" class="ar-submit" id="arSubmit">
          Enviar propuesta
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>
        </button>

        <p class="ar-error" id="arError" role="alert"></p>
      </form>

      <div class="ar-success" id="arSuccess" hidden>
        <div class="ar-success-mark">✦</div>
        <h3>¡Propuesta recibida!</h3>
        <p>La escuchamos y te escribimos. Te acabamos de mandar un email de confirmación.</p>
      </div>
    </div>
  </section>

  <section class="ar-section ar-section--line" aria-labelledby="arFaqTitle">
    <div class="ar-head">
      <span class="ar-kicker">DUDAS FRECUENTES</span>
      <h2 class="ar-h2" id="arFaqTitle">Lo que suelen preguntarnos</h2>
    </div>
    <ul class="ar-faq">
      {faq.map((item) => (
        <li data-reveal>
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        </li>
      ))}
    </ul>
  </section>

  <section class="ar-cta">
    <h2>¿Te subimos<br/>al escenario?</h2>
    <p>Mándanos un vídeo en directo y cuéntanos qué hacéis. Del resto hablamos.</p>
    <a class="ar-btn ar-btn--solid" href="#propuesta">Mandar propuesta</a>
  </section>

</main>

<SiteFooter />

<script is:inline>
  (function() {
    var form    = document.getElementById('arForm');
    var success = document.getElementById('arSuccess');
    var wrap    = document.getElementById('arFormWrap');
    var errEl   = document.getElementById('arError');
    var btn     = document.getElementById('arSubmit');
    if (!form) return;

    function val(id) { return document.getElementById(id).value.trim(); }
    function isValidEmail(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v); }
    function showErr(msg) { errEl.textContent = msg; errEl.classList.add('show'); }
    function clearErr() { errEl.textContent = ''; errEl.classList.remove('show'); }

    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      clearErr();

      var artista = val('arArtista');
      var nombre  = val('arNombre');
      var email   = val('arEmail');
      var disciplina = document.getElementById('arDisciplina').value;

      if (!artista || !nombre || !email) { showErr('Completa al menos nombre artístico, contacto y email.'); return; }
      if (!isValidEmail(email)) { showErr('Revisa el formato del email.'); return; }

      var original = btn.innerHTML;
      btn.disabled = true;
      btn.textContent = 'Enviando…';

      try {
        // Mismo endpoint que /contacto: "artista" cambia el aviso y la
        // auto-respuesta, y el lead entra en la misma tabla de Airtable.
        var res = await fetch('/api/contacto', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: nombre,
            email: email,
            phone: val('arTelefono'),
            clientType: 'artista',
            artistName: artista,
            eventType: disciplina,
            goal: document.getElementById('arBusca').value,
            style: val('arEstilo'),
            location: val('arBase'),
            links: val('arEnlaces'),
            consulta: val('arConsulta'),
            website: document.getElementById('arWebsite').value
          })
        });
        if (!res.ok) throw new Error('Envío rechazado (' + res.status + ')');

        // Evento propio y no generate_lead: una propuesta de artista no es
        // un cliente, y mezclarlas inflaría las conversiones de venta.
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'artist_submission', {
            page_path: window.location.pathname,
            discipline: disciplina || 'no indicado'
          });
        }

        form.hidden = true;
        success.hidden = false;
        wrap.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (err) {
        console.error('Propuesta error:', err);
        showErr('No hemos podido enviar la propuesta. Inténtalo en unos segundos.');
        btn.disabled = false;
        btn.innerHTML = original;
      }
    });
  })();
</script>

<style>
  .ar { background: #000; color: #F3F3F0; font-family: "BSP Helvetica", sans-serif; }

  /* Hero partido: la foto es vertical y a sangre completa en pantalla ancha
     se quedaba en un recorte de la cara. Texto a la izquierda, foto entera a la derecha. */
  .ar-hero { display: grid; grid-template-columns: 1.15fr 1fr; min-height: 100vh; min-height: 100svh; }
  .ar-hero-content { display: flex; flex-direction: column; justify-content: flex-end; padding: clamp(112px, 15vh, 160px) clamp(20px, 5vw, 88px) clamp(48px, 9vh, 96px); }
  .ar-hero-media { position: relative; overflow: hidden; }
  .ar-hero-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 40% center; display: block; }
  .ar-hero-media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, #000 0%, rgba(0,0,0,0) 22%); pointer-events: none; }
  .ar-h1 { margin: 0; font: inherit; }
  .ar-eyebrow { display: block; font-size: 11px; letter-spacing: .3em; text-transform: uppercase; color: rgba(243, 243, 240,.75); margin: 0 0 22px; }
  .ar-title { display: block; font-size: clamp(44px, 6vw, 96px); font-weight: 800; letter-spacing: -.045em; line-height: .95; margin: 0 0 28px; }
  .ar-sub { font-size: clamp(15px, 1.35vw, 19px); line-height: 1.6; color: rgba(243, 243, 240,.82); max-width: 52ch; margin: 0 0 36px; }
  .ar-btn { display: inline-block; align-self: flex-start; font-size: 14px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: #F3F3F0; border: 2px solid #F3F3F0; padding: 15px 34px; text-decoration: none; transition: background .25s, color .25s; }
  .ar-btn:hover { background: #F3F3F0; color: #000; }
  .ar-btn--solid { background: #F3F3F0; color: #000; }
  .ar-btn--solid:hover { background: transparent; color: #F3F3F0; }

  .ar-section { padding: clamp(72px, 9vw, 128px) clamp(20px, 5vw, 88px); }
  .ar-section--line { border-top: 1px solid rgba(243, 243, 240,.1); }
  .ar-head { margin: 0 0 clamp(32px, 4vw, 56px); }
  .ar-kicker { display: block; font-size: 11px; letter-spacing: .28em; color: rgba(243, 243, 240,.5); margin-bottom: 16px; font-weight: 500; }
  .ar-h2 { font-size: clamp(30px, 4vw, 52px); font-weight: 800; letter-spacing: -.03em; line-height: 1; margin: 0; }
  .ar-lead { font-size: 16px; line-height: 1.7; color: rgba(243, 243, 240,.65); margin: 20px 0 0; max-width: 60ch; }

  .ar-formats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid rgba(243, 243, 240,.14); }
  .ar-formats li { padding: 28px 24px 32px 0; border-bottom: 1px solid rgba(243, 243, 240,.14); }
  .ar-formats li:not(:nth-child(4n+1)) { padding-left: 24px; border-left: 1px solid rgba(243, 243, 240,.14); }
  .ar-formats h3 { font-size: clamp(18px, 1.6vw, 22px); font-weight: 700; letter-spacing: -.01em; line-height: 1.2; margin: 0 0 10px; }
  .ar-formats p { font-size: 16px; line-height: 1.6; color: rgba(243, 243, 240,.6); margin: 0; }

  .ar-ways { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 2vw, 28px); }
  .ar-way { border: 1px solid rgba(243, 243, 240,.16); padding: clamp(28px, 3.5vw, 44px); display: flex; flex-direction: column; }
  .ar-way-tag { display: block; font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: rgba(243, 243, 240,.5); margin-bottom: 14px; font-weight: 600; }
  .ar-way h3 { font-size: clamp(22px, 2.2vw, 32px); font-weight: 800; letter-spacing: -.02em; line-height: 1.05; margin: 0 0 18px; }
  .ar-way p { font-size: 16px; line-height: 1.65; color: rgba(243, 243, 240,.65); margin: 0 0 24px; flex: 1; }
  .ar-link { color: #F3F3F0; font-size: 13px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; text-decoration: none; align-self: flex-start; border-bottom: 1px solid currentColor; padding-bottom: 4px; }

  .ar-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(20px, 2.5vw, 40px); }
  .ar-step-num { display: block; font-size: clamp(40px, 5vw, 72px); font-weight: 800; letter-spacing: -.05em; line-height: .9; color: rgba(243, 243, 240,.2); margin-bottom: 18px; }
  .ar-steps h3 { font-size: 19px; font-weight: 700; margin: 0 0 10px; }
  .ar-steps p { font-size: 16px; line-height: 1.6; color: rgba(243, 243, 240,.6); margin: 0; }

  .ar-proof { display: grid; grid-template-columns: 1fr 1fr; align-items: stretch; border-top: 1px solid rgba(243, 243, 240,.1); }
  .ar-proof img { width: 100%; height: 100%; min-height: 420px; object-fit: cover; display: block; }
  .ar-proof-text { padding: clamp(48px, 6vw, 96px) clamp(20px, 5vw, 88px); display: flex; flex-direction: column; justify-content: center; }
