---
import Layout from "../layouts/Layout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SITE, absUrl } from "../config/site.mjs";

// Con pocos proyectos no hay filtro: cabecera + mosaico. Cuando haya más,
// basta con añadir entradas aquí (image → foto a sangre; logo → logo centrado sobre fondo oscuro).
const projects = [
  {
    href: "/proyectos/halloween-fest",
    name: "Halloween Fest",
    cat: "Producción · 4 ediciones",
    image: null,
    logo: "/images/halloween-fest/logo-halloween-fest.webp",
    logoSize: [677, 261],
    alt: "Logo de Halloween Fest",
  },
  {
    href: "/proyectos/bendito-castigo",
    name: "Bendito Castigo",
    cat: "Concepto propio",
    image: null,
    logo: "/images/bendito-castigo/isologo-bendito-castigo.webp",
    logoSize: [736, 611],
    alt: "Isologo de Bendito Castigo: luna creciente con estrella",
  },
  {
    href: "/proyectos/conclave-x-la-caseta",
    name: "Nochebuena & Nochevieja",
    cat: "Organización y producción",
    image: null,
    logo: "/images/navidad/logo-conclave.webp",
    logoSize: [1600, 316],
    alt: "Cónclave",
  },
];
---

<Layout
  title={`Proyectos | ${SITE.name} — Producción de eventos`}
  description="Proyectos y conceptos de Black Sun Prods: producción de eventos, fiestas temáticas y conceptos musicales propios desde Jaén."
  canonical={absUrl("/proyectos")}
>

<Fragment slot="head">
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Inicio", "item": absUrl("/") },
          { "@type": "ListItem", "position": 2, "name": "Proyectos", "item": absUrl("/proyectos") }
        ]
      },
      {
        "@type": "CollectionPage",
        "name": "Proyectos de Black Sun Prods",
        "description": "Eventos producidos y conceptos propios de Black Sun Prods en Jaén y Andalucía.",
        "url": absUrl("/proyectos"),
        "inLanguage": "es-ES",
        "mainEntity": {
          "@type": "ItemList",
          "itemListElement": projects.map((p, i) => ({
            "@type": "ListItem",
            "position": i + 1,
            "name": p.name,
            "url": absUrl(p.href)
          }))
        }
      }
    ]
  })} />
</Fragment>

<section class="pj-head">
  <p class="pj-eyebrow">NUESTRA EXPERIENCIA</p>
  <h1 class="pj-title">Proyectos</h1>
  <p class="pj-sub">Eventos que hemos producido y conceptos propios que estamos llevando al directo.</p>
</section>

<div class="tp-grid">
  {projects.map((p, i) => (
    <a class="tp-item" href={p.href}>
      {p.image
        ? <img class="tp-img" src={p.image} alt={p.alt} width={p.imageSize?.[0]} height={p.imageSize?.[1]} fetchpriority={i === 0 ? "high" : undefined} loading={i === 0 ? undefined : "lazy"}/>
        : <div class="tp-img tp-concept"><img src={p.logo} alt={p.alt} width={p.logoSize[0]} height={p.logoSize[1]} loading={i === 0 ? undefined : "lazy"}/></div>}
      <div class="tp-hover">
        <span class="tp-hover-cat">{p.cat}</span>
        <span class="tp-hover-title">{p.name}</span>
      </div>
    </a>
  ))}
</div>

<section class="tp-also" aria-labelledby="tpAlsoTitle">
  <h2 class="tp-also-title" id="tpAlsoTitle">Y además</h2>
  <div class="tp-also-grid">
    <a class="tp-also-card" href="/ayuntamientos">
      <span class="tp-also-kicker">Ayuntamientos</span>
      <p>Fiestas patronales, festivales y programación cultural, producidas de principio a fin.</p>
      <span class="tp-also-arrow" aria-hidden="true">→</span>
    </a>
    <a class="tp-also-card" href="/sonido-e-iluminacion">
      <span class="tp-also-kicker">Sonido e iluminación</span>
      <p>Alquilamos y operamos el rider técnico, sin necesidad de producir el evento entero.</p>
      <span class="tp-also-arrow" aria-hidden="true">→</span>
    </a>
  </div>
</section>

<div class="tp-cta">
  <h2 class="tp-cta-title">¿hablamos de<br/>tu evento?</h2>
  <a href="/contacto">Cuéntanos la fecha ›</a>
</div>

<SiteFooter />

<style>
  body { background: #000 !important; }

  .pj-head { padding: 160px clamp(20px, 5vw, 88px) clamp(40px, 5vw, 64px); font-family: "Montserrat", sans-serif; color: #F3F3F0; }
  .pj-eyebrow { font-size: 11px; letter-spacing: .28em; color: rgba(243, 243, 240,.5); margin: 0 0 18px; font-weight: 500; }
  .pj-title { font-size: clamp(52px, 8.4vw, 120px); font-weight: 800; letter-spacing: -.04em; line-height: .9; margin: 0 0 24px; }
  .pj-sub { font-size: clamp(15px, 1.3vw, 18px); line-height: 1.6; color: rgba(243, 243, 240,.6); max-width: 48ch; margin: 0; }

  .tp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; background: #000; }
  .tp-item { position: relative; overflow: hidden; display: block; text-decoration: none; color: inherit; aspect-ratio: 1 / 1; }
  .tp-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .5s cubic-bezier(.25,.46,.45,.94); }
  .tp-item:hover .tp-img { transform: scale(1.05); }

  .tp-concept { display: flex; align-items: center; justify-content: center; background: #0d0d0d; border: 1px solid rgba(243, 243, 240,.08); box-sizing: border-box; }
  .tp-concept img { width: 42%; height: auto; }

  .tp-hover { position: absolute; inset: 0; background: rgba(0,0,0,.7); opacity: 0; transition: opacity .3s ease; display: flex; flex-direction: column; justify-content: flex-end; padding: 20px; font-family: "Montserrat", sans-serif; }
  .tp-item:hover .tp-hover, .tp-item:focus-visible .tp-hover { opacity: 1; }
  .tp-hover-cat { font-size: 12px; font-weight: 600; letter-spacing: .28em; text-transform: uppercase; color: rgba(243, 243, 240,.55); margin-bottom: 12px; }
  .tp-hover-title { font-size: 32px; font-weight: 700; letter-spacing: -.025em; line-height: .98; color: #F3F3F0; }

  /* Escritorio: primer proyecto ancho (2 columnas), el resto cuadrado */
  @media (min-width: 769px) {
    .tp-item:first-child { grid-column: span 2; aspect-ratio: 2 / 1; }
    /* Tercer proyecto: fila completa, con el logo apaisado más estrecho */
    .tp-item:nth-child(3) { grid-column: 1 / -1; aspect-ratio: 3 / 1; }
    .tp-item:nth-child(3) .tp-concept img { width: 28%; }
  }

  /* Dos servicios que no son "proyectos" pero salen de aquí */
  .tp-also { background: #000; font-family: "Montserrat", sans-serif; padding: clamp(72px, 9vw, 120px) clamp(20px, 5vw, 88px) 0; border-top: 1px solid rgba(255,255,255,.06); }
  .tp-also-title { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: rgba(243, 243, 240,.5); font-weight: 500; margin: 0 0 clamp(24px, 3vw, 40px); }
  .tp-also-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(12px, 1.5vw, 20px); }
  .tp-also-card { position: relative; display: block; text-decoration: none; color: inherit; border: 1px solid rgba(243, 243, 240,.14); padding: clamp(28px, 3.5vw, 44px); transition: background .25s, border-color .25s; }
  .tp-also-card:hover { background: rgba(243, 243, 240,.04); border-color: rgba(243, 243, 240,.3); }
  .tp-also-kicker { display: block; font-size: clamp(20px, 2.2vw, 28px); font-weight: 800; letter-spacing: -.02em; color: #F3F3F0; margin-bottom: 14px; }
  .tp-also-card p { font-size: 15px; line-height: 1.7; color: rgba(243, 243, 240,.6); margin: 0 0 32px; max-width: 34ch; }
  .tp-also-arrow { font-size: 20px; color: rgba(243, 243, 240,.5); transition: transform .25s, color .25s; display: inline-block; }
  .tp-also-card:hover .tp-also-arrow { transform: translateX(6px); color: #F3F3F0; }

  .tp-cta { background: #000; padding: clamp(80px, 10vw, 130px) 40px 60px; text-align: center; font-family: "Montserrat", sans-serif; }
  .tp-cta-title { font-size: clamp(34px, 6vw, 80px); font-weight: 800; letter-spacing: -.04em; line-height: .98; margin: 0 0 36px; }
  /* El botón, con `>` y en bloque: si es inline su padding no levanta la línea
     y lo que venga debajo se le monta encima. */
  .tp-cta > a { display: inline-block; font-size: 13px; font-weight: 600; letter-spacing: .15em; text-transform: uppercase; color: #F3F3F0; text-decoration: none; border: 1.5px solid rgba(255,255,255,.5); padding: 12px 28px; transition: background .2s, color .2s; }
  .tp-cta > a:hover { background: #F3F3F0; color: #000; }

  @media (max-width: 768px) {
    .pj-head { padding-top: 120px; }
    .tp-grid { grid-template-columns: 1fr; }
    .tp-hover { opacity: 1; background: linear-gradient(180deg, transparent 50%, rgba(0,0,0,.75) 100%); }
    .tp-hover-title { font-size: 26px; }
    .tp-also-grid { grid-template-columns: 1fr; }
    .tp-cta { padding: 64px 24px 40px; }
  }
</style>

</Layout>
