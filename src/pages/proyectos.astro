---
import Layout from "../layouts/Layout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SITE, absUrl } from "../config/site.mjs";

// Con pocos proyectos no hay filtro: cabecera + mosaico. Cuando haya más,
// basta con añadir entradas aquí (image: null → tarjeta tipográfica).
const projects = [
  {
    href: "/proyectos/halloween-fest",
    name: "Halloween Fest",
    cat: "Producción · 4 ediciones",
    image: "/images/halloween-fest/hw3-07.webp",
    alt: "Halloween Fest — público en la pista durante una de sus ediciones en Jaén",
  },
  {
    href: "/proyectos/bendito-castigo",
    name: "Bendito Castigo",
    cat: "Concepto propio",
    image: null,
    alt: "",
  },
];
---

<Layout
  title={`Proyectos | ${SITE.name} — Producción de eventos`}
  description="Proyectos y conceptos de Black Sun Prods: producción de eventos, fiestas temáticas y conceptos musicales propios desde Jaén."
  canonical={absUrl("/proyectos")}
>

<section class="pj-head">
  <p class="pj-eyebrow">NUESTRA EXPERIENCIA</p>
  <h1 class="pj-title">proyectos</h1>
  <p class="pj-sub">Eventos que hemos producido y conceptos propios que estamos llevando al directo.</p>
</section>

<div class="tp-grid">
  {projects.map((p, i) => (
    <a class="tp-item" href={p.href}>
      {p.image
        ? <img class="tp-img" src={p.image} alt={p.alt} fetchpriority={i === 0 ? "high" : undefined} loading={i === 0 ? undefined : "lazy"}/>
        : <div class="tp-img tp-concept" aria-hidden="true"><span set:html={p.name.toLowerCase().replace(" ", "<br/>")}/></div>}
      <div class="tp-hover">
        <span class="tp-hover-cat">{p.cat}</span>
        <span class="tp-hover-title">{p.name}</span>
      </div>
    </a>
  ))}
</div>

<div class="tp-cta">
  <p>¿Tienes un evento en mente?</p>
  <a href="/contacto">Hablemos de tu evento ›</a>
</div>

<SiteFooter />

<style>
  body { background: #000 !important; }

  .pj-head { padding: 160px clamp(20px, 5vw, 88px) clamp(40px, 5vw, 64px); font-family: "Montserrat", sans-serif; color: #F3F3F0; }
  .pj-eyebrow { font-size: 11px; letter-spacing: .28em; color: rgba(243, 243, 240,.5); margin: 0 0 18px; font-weight: 500; }
  .pj-title { font-size: clamp(56px, 9vw, 130px); font-weight: 800; letter-spacing: -.04em; line-height: .9; margin: 0 0 24px; }
  .pj-sub { font-size: clamp(15px, 1.3vw, 18px); line-height: 1.6; color: rgba(243, 243, 240,.6); max-width: 48ch; margin: 0; }

  .tp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; background: #000; }
  .tp-item { position: relative; overflow: hidden; display: block; text-decoration: none; color: inherit; aspect-ratio: 1 / 1; }
  .tp-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .5s cubic-bezier(.25,.46,.45,.94); }
  .tp-item:hover .tp-img { transform: scale(1.05); }

  .tp-concept { display: flex; align-items: center; justify-content: center; background: #0d0d0d; border: 1px solid rgba(243, 243, 240,.08); box-sizing: border-box; }
  .tp-concept span { font-family: "Montserrat", sans-serif; font-size: clamp(34px, 4.4vw, 68px); font-weight: 800; font-style: italic; line-height: .92; letter-spacing: -.04em; text-align: center; color: #F3F3F0; }

  .tp-hover { position: absolute; inset: 0; background: rgba(0,0,0,.7); opacity: 0; transition: opacity .3s ease; display: flex; flex-direction: column; justify-content: flex-end; padding: 20px; font-family: "Montserrat", sans-serif; }
  .tp-item:hover .tp-hover, .tp-item:focus-visible .tp-hover { opacity: 1; }
  .tp-hover-cat { font-size: 12px; font-weight: 600; letter-spacing: .28em; text-transform: uppercase; color: rgba(243, 243, 240,.55); margin-bottom: 12px; }
  .tp-hover-title { font-size: 32px; font-weight: 700; letter-spacing: -.025em; line-height: .98; color: #F3F3F0; }

  /* Escritorio: primer proyecto ancho (2 columnas), el resto cuadrado */
  @media (min-width: 769px) {
    .tp-item:first-child { grid-column: span 2; aspect-ratio: 2 / 1; }
  }

  .tp-cta { background: #000; padding: 130px 40px 60px; text-align: center; font-family: "Montserrat", sans-serif; border-top: 1px solid rgba(255,255,255,.06); }
  .tp-cta p { font-size: 16px; color: rgba(255,255,255,.5); margin: 0 0 20px; }
  .tp-cta a { font-size: 13px; font-weight: 600; letter-spacing: .15em; text-transform: uppercase; color: #F3F3F0; text-decoration: none; border: 1.5px solid rgba(255,255,255,.5); padding: 12px 28px; transition: background .2s, color .2s; }
  .tp-cta a:hover { background: #F3F3F0; color: #000; }

  @media (max-width: 768px) {
    .pj-head { padding-top: 120px; }
    .tp-grid { grid-template-columns: 1fr; }
    .tp-hover { opacity: 1; background: linear-gradient(180deg, transparent 50%, rgba(0,0,0,.75) 100%); }
    .tp-hover-title { font-size: 26px; }
    .tp-cta { padding: 64px 24px 40px; }
  }
</style>

</Layout>
