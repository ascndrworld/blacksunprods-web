---
/*
 * /juego/sorteo?key=… — Panel privado del juego del visualizer. El sorteo es
 * automático (gana uno de cada grupo de escaneos de /juego, ver
 * lib/juego): aquí solo se ven los ganadores en directo y se marcan los premios
 * entregados. Misma clave que /halloween-fest/stats (CD_STATS_KEY); sin ella, 404.
 * Con &prueba trabaja sobre los números de prueba (/juego?prueba).
 */
import { GRUPO, NUMEROS, PREMIOS } from "../../lib/juego";

export const prerender = false;

const KEY = import.meta.env.CD_STATS_KEY ?? (globalThis as any).process?.env?.CD_STATS_KEY;
if (!KEY || Astro.url.searchParams.get("key") !== KEY) {
  return new Response("Not found", { status: 404 });
}
Astro.response.headers.set("Cache-Control", "no-store");
const prueba = Astro.url.searchParams.has("prueba");
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="robots" content="noindex, nofollow"/>
  <title>Sorteo · Halloween Fest V</title>
  <style is:global>
    @font-face { font-family: "BSP Helvetica Black"; src: url("/fonts/helvetica-neue/HelveticaNeueBlack.woff2") format("woff2"); font-weight: 900; }
    :root { color-scheme: dark; --bg: #0b0b0b; --fg: #eee; --mute: #888; --line: #262626; --acc: #ec3a26; --ok: #3ccf6e; }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--fg); font: 15px/1.45 "Helvetica Neue", Helvetica, Arial, sans-serif; }
    main { max-width: 760px; margin: 0 auto; padding: 24px 16px 48px; }
    h1 { font-size: 20px; margin: 0 0 4px; }
    .sub { color: var(--mute); margin: 0 0 20px; font-size: 13px; }
    .prueba { display: inline-block; background: #f6c813; color: #000; font-weight: 700; font-size: 12px; padding: 2px 8px; border-radius: 4px; margin-left: 8px; vertical-align: 3px; }
    .tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 24px; }
    .tile { border: 1px solid var(--line); border-radius: 8px; padding: 12px; }
    .tile b { display: block; font-size: 28px; font-variant-numeric: tabular-nums; }
    .tile span { color: var(--mute); font-size: 12px; }
    .tile.acc b { color: var(--acc); }
    button { font: inherit; cursor: pointer; }
    h2 { font-size: 13px; text-transform: uppercase; letter-spacing: .08em; color: var(--mute); margin: 0 0 8px; }
    ol { list-style: none; margin: 0; padding: 0; }
    li { display: flex; align-items: center; gap: 12px; padding: 10px 4px; border-bottom: 1px solid var(--line); }
    li .n { font-family: "BSP Helvetica Black", sans-serif; font-size: 28px; width: 3.4em; font-variant-numeric: tabular-nums; }
    li .p { flex: 1; font-size: 14px; }
    li.ok .n, li.ok .p { color: var(--mute); text-decoration: line-through; }
    li button { padding: 8px 12px; border-radius: 8px; border: 1px solid var(--line); background: #161616; color: var(--fg); font-size: 13px; white-space: nowrap; }
    li.ok button { border-color: var(--ok); color: var(--ok); }
    .err { border: 1px solid var(--acc); color: var(--acc); padding: 12px; border-radius: 8px; margin-bottom: 16px; }
  </style>
</head>
<body data-prueba={prueba ? "1" : ""} data-premios={PREMIOS.length}>
  <main>
    <h1>Juego del visualizer {prueba && <span class="prueba">PRUEBA</span>}</h1>
    <p class="sub">Automático: cada escaneo recibe un número al azar, y de cada {GRUPO} escaneos uno recibe un número premiado ({NUMEROS.map((n) => `#${n}`).join(" ")}) hasta repartir los {PREMIOS.length} (entre los {GRUPO * PREMIOS.length} primeros). Cada uno lo ve al momento en su móvil. Cuando un ganador recoja su premio en la barra, búscalo por su número y márcalo como entregado: su pantalla lo mostrará y no podrá reclamarlo otra vez. Se actualiza solo.</p>
    <p class="err" id="err" hidden></p>

    <div class="tiles">
      <div class="tile"><b id="total">–</b><span>Han escaneado</span></div>
      <div class="tile acc"><b id="ganados">–</b><span>Premios ganados</span></div>
      <div class="tile"><b id="entregados">–</b><span>Premios entregados</span></div>
    </div>

    <h2>Ganadores</h2>
    <ol id="lista"></ol>
    <p class="sub" id="vacia">Aún no ha ganado nadie.</p>
  </main>

  <script>
    const key = new URLSearchParams(location.search).get("key");
    const prueba = document.body.dataset.prueba === "1";
    const nPremios = Number(document.body.dataset.premios);
    const $ = (id: string) => document.getElementById(id)!;
    type R = { total: number; ganadores: { n: string; premio: string }[]; ok: string[]; error?: string };

    async function api(accion: string, extra: object = {}): Promise<R> {
      const r = await fetch("/api/juego", { method: "POST", body: JSON.stringify({ key, prueba, accion, ...extra }) });
      const d = await r.json();
      if (!r.ok || d.error) throw new Error(d.error || r.status);
      return d;
    }

    function pintar(d: R) {
      $("err").hidden = true;
      $("total").textContent = String(d.total);
      $("ganados").textContent = `${d.ganadores.length}/${nPremios}`;
      $("entregados").textContent = `${d.ok.length}/${nPremios}`;
      $("vacia").hidden = d.ganadores.length > 0;
      // Ordenados por número, que es lo que enseñan en la barra.
      $("lista").innerHTML = [...d.ganadores].sort((a, b) => a.n.localeCompare(b.n)).map(({ n, premio }) => {
        const ok = d.ok.includes(n);
        return `<li class="${ok ? "ok" : ""}"><span class="n">#${n}</span><span class="p">${premio}</span>` +
          `<button data-n="${n}" data-ok="${ok ? "" : "1"}">${ok ? "✓ Entregado" : "Marcar entregado"}</button></li>`;
      }).join("");
    }
    const fallo = (e: unknown) => { $("err").textContent = `Error: ${(e as Error).message}. Comprueba la conexión.`; $("err").hidden = false; };

    $("lista").addEventListener("click", async (ev) => {
      const b = (ev.target as HTMLElement).closest("button");
      if (!b) return;
      b.disabled = true;
      try { pintar(await api("entregado", { n: b.dataset.n, ok: b.dataset.ok === "1" })); }
      catch (e) { b.disabled = false; fallo(e); }
    });

    const ver = () => api("ver").then(pintar).catch(fallo);
    ver(); setInterval(ver, 5000);
  </script>
</body>
</html>
