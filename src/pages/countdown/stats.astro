---
/*
 * /countdown/stats?key=… — Cifras privadas de la landing de Halloween Fest V.
 * Se protege con CD_STATS_KEY (variable de entorno de Vercel). Sin la clave
 * correcta responde 404, como si no existiera.
 */
import { EVENTS, hasStore, readAll, type CdEvent, type DayStats } from "../../lib/countdownStats";

export const prerender = false;

const KEY =
  import.meta.env.CD_STATS_KEY ?? (globalThis as any).process?.env?.CD_STATS_KEY;
if (!KEY || Astro.url.searchParams.get("key") !== KEY) {
  return new Response("Not found", { status: 404 });
}
Astro.response.headers.set("Cache-Control", "no-store");

let days: DayStats[] = [];
let error = "";
if (!hasStore()) error = "Falta conectar Upstash Redis (KV_REST_API_URL / KV_REST_API_TOKEN).";
else {
  try { days = await readAll(); }
  catch (e) { error = String((e as Error).message ?? e); }
}

const ev = Object.keys(EVENTS) as CdEvent[];
// "qr" y "directo" se muestran juntos: el QR apunta a la misma URL que se
// comparte sin etiqueta, así que no se distinguen de verdad.
const QR = "QR Directo";
const group = (s: string) => (s === "qr" || s === "directo" ? QR : s);
const sum = (c: Record<string, number>, e: string, src?: string) =>
  Object.entries(c).reduce((n, [k, v]) => {
    const [ke, ks] = k.split(":");
    return ke === e && (src === undefined || group(ks) === src) ? n + v : n;
  }, 0);

const totals: Record<string, number> = {};
for (const d of days) for (const [k, v] of Object.entries(d.counts)) totals[k] = (totals[k] ?? 0) + v;
const sources = [...new Set(Object.keys(totals).map((k) => group(k.split(":")[1])))]
  .sort((a, b) => sum(totals, "view", b) - sum(totals, "view", a));
const fmt = (n: number) => new Intl.NumberFormat("es-ES").format(n);
const dayLabel = (d: string) => `${d.slice(8, 10)}/${d.slice(5, 7)}`;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="robots" content="noindex, nofollow"/>
  <title>Countdown · cifras</title>
  <style>
    :root { color-scheme: dark; --bg:#0b0b0b; --fg:#eee; --mute:#888; --line:#262626; --acc:#ff5a1f; }
    body { margin:0; background:var(--bg); color:var(--fg); font:15px/1.45 "Helvetica Neue", Helvetica, Arial, sans-serif; }
    main { max-width:720px; margin:0 auto; padding:28px 16px 48px; }
    h1 { font-size:20px; margin:0 0 4px; letter-spacing:.02em; }
    .sub { color:var(--mute); margin:0 0 24px; font-size:13px; }
    .tiles { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:10px; margin-bottom:28px; }
    .tile { border:1px solid var(--line); border-radius:8px; padding:14px; }
    .tile b { display:block; font-size:30px; font-variant-numeric:tabular-nums; }
    .tile span { color:var(--mute); font-size:12px; }
    .tile.acc b { color:var(--acc); }
    h2 { font-size:13px; text-transform:uppercase; letter-spacing:.08em; color:var(--mute); margin:28px 0 8px; }
    .scroll { overflow-x:auto; }
    table { width:100%; border-collapse:collapse; font-variant-numeric:tabular-nums; }
    th, td { text-align:right; padding:7px 8px; border-bottom:1px solid var(--line); white-space:nowrap; }
    th:first-child, td:first-child { text-align:left; }
    th { color:var(--mute); font-weight:500; font-size:12px; }
    .err { border:1px solid var(--acc); color:var(--acc); padding:12px; border-radius:8px; }
  </style>
</head>
<body>
  <main>
    <h1>Halloween Fest V · /countdown</h1>
    <p class="sub">Totales sin cookies. «QR Directo» junta los escaneos y el enlace sin etiqueta. Los días van en hora de Madrid.</p>

    {error && <p class="err">{error}</p>}

    <div class="tiles">
      <div class="tile acc"><b>{fmt(sum(totals, "view", QR))}</b><span>QR Directo</span></div>
      {ev.map((e) => <div class="tile"><b>{fmt(sum(totals, e))}</b><span>{EVENTS[e]}</span></div>)}
    </div>

    {sources.length > 0 && (
      <Fragment>
        <h2>Por origen</h2>
        <div class="scroll"><table>
          <thead><tr><th>Origen</th>{ev.map((e) => <th>{EVENTS[e]}</th>)}</tr></thead>
          <tbody>{sources.map((s) => (
            <tr><td>{s.charAt(0).toUpperCase() + s.slice(1)}</td>{ev.map((e) => <td>{fmt(sum(totals, e, s))}</td>)}</tr>
          ))}</tbody>
        </table></div>

        <h2>Por día</h2>
        <div class="scroll"><table>
          <thead><tr><th>Día</th><th>QR Directo</th>{ev.map((e) => <th>{EVENTS[e]}</th>)}</tr></thead>
          <tbody>{days.map((d) => (
            <tr><td>{dayLabel(d.day)}</td><td>{fmt(sum(d.counts, "view", QR))}</td>{ev.map((e) => <td>{fmt(sum(d.counts, e))}</td>)}</tr>
          ))}</tbody>
        </table></div>
      </Fragment>
    )}
    {!error && sources.length === 0 && <p class="sub">Aún no hay datos.</p>}
  </main>
</body>
</html>
