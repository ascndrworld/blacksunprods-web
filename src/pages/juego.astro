---
/*
 * /juego — El QR del visualizer de Halloween Fest V lleva aquí. Tras unos
 * 3 segundos de «análisis», cada móvil recibe un número de 4 cifras
 * (siempre el mismo, aunque vuelva a escanear) y sabe al momento si ha ganado:
 * solo los números elegidos tienen premio y sale uno de cada 3 escaneos (ver
 * lib/juego). Si gana, la pantalla se pone en rojo con su premio y avisa sola cuando se marca como entregado en
 * /juego/sorteo; si no, «GAME OVER».
 *
 * Solo reparte números la noche del evento (ver OPENS/CLOSES en lib/juego).
 * Para probar sin tocar los números reales: /juego?prueba
 */
import { CLOSES, FRASES_GAME_OVER, FRASES_GANA, OPENS } from "../lib/juego";
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
  <meta name="robots" content="noindex, nofollow"/>
  <meta name="theme-color" content="#000000"/>
  <title>Halloween Fest V · El juego</title>
  <link rel="preload" href="/fonts/helvetica-neue/HelveticaNeueBlack.woff2" as="font" type="font/woff2" crossorigin/>
  <link rel="preload" href="/fonts/helvetica-neue/HelveticaNeueBold.woff2" as="font" type="font/woff2" crossorigin/>
  <style is:global>
    @font-face { font-family: "BSP Helvetica"; src: url("/fonts/helvetica-neue/HelveticaNeueMedium.woff2") format("woff2"); font-weight: 500; font-display: swap; }
    @font-face { font-family: "BSP Helvetica"; src: url("/fonts/helvetica-neue/HelveticaNeueBold.woff2") format("woff2"); font-weight: 700; font-display: swap; }
    @font-face { font-family: "BSP Helvetica Black"; src: url("/fonts/helvetica-neue/HelveticaNeueBlack.woff2") format("woff2"); font-weight: 900; font-display: swap; }

    :root { --bone: #EDE8E1; --red: #ec3a26; --red-deep: #C4241A; --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { height: 100%; background: #000; }
    body {
      min-height: 100%; font-family: "BSP Helvetica", "Helvetica Neue", Helvetica, Arial, sans-serif; color: var(--bone);
      -webkit-font-smoothing: antialiased; overflow: hidden;
      display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;
      padding: max(64px, env(safe-area-inset-top)) 20px max(64px, env(safe-area-inset-bottom));
    }
    .bg { position: fixed; inset: 0; z-index: -2; background: url("/images/halloween-v/escena-v.webp") center / cover no-repeat; filter: blur(6px) brightness(.32); transform: scale(1.06); transition: filter .6s; }
    .fx { position: fixed; inset: 0; z-index: -1; pointer-events: none;
      background: repeating-linear-gradient(to bottom, rgba(0,0,0,.25) 0, rgba(0,0,0,.25) 1px, transparent 1px, transparent 4px),
                  radial-gradient(ellipse 90% 70% at 50% 50%, transparent 40%, rgba(0,0,0,.75) 100%); }

    .osd { position: fixed; top: max(18px, env(safe-area-inset-top)); font: 700 15px var(--mono); letter-spacing: .08em; color: #f4f4f4; text-shadow: 2px 0 rgba(255,0,60,.75), -2px 0 rgba(0,220,255,.6); }
    .osd--l { left: 18px; } .osd--r { right: 18px; }
    .osd--b { top: auto; bottom: max(18px, env(safe-area-inset-bottom)); font-size: 13px; opacity: .8; }
    .rec::before { content: "●"; color: var(--red); margin-right: .4em; animation: blink 1s steps(1) infinite; }
    @keyframes blink { 50% { opacity: 0; } }

    .kicker { font-size: 13px; font-weight: 700; letter-spacing: .32em; text-indent: .32em; text-transform: uppercase; color: var(--red); }
    h1 { font-family: "BSP Helvetica Black", sans-serif; font-weight: 900; text-transform: uppercase; letter-spacing: -.04em; line-height: .92;
      font-size: clamp(34px, 11vw, 64px); margin: 14px 0 0;
      text-shadow: .06em .05em 0 #e3161a, .03em .02em 0 #9a8cff, 0 0 30px rgba(255,30,20,.6); }

    /* El número: grande, con aberración VHS y un tirón de vez en cuando */
    .num { position: relative; font-family: "BSP Helvetica Black", sans-serif; font-weight: 900; line-height: .8; letter-spacing: -.05em;
      font-size: clamp(80px, 27vw, 200px); margin: 22px 0 6px; font-variant-numeric: tabular-nums;
      color: var(--bone); text-shadow: .035em 0 rgba(255,0,60,.8), -.03em 0 rgba(0,220,255,.6), 0 0 40px rgba(255,40,25,.55);
      animation: jitter 5s infinite; }
    @keyframes jitter { 0%, 92%, 100% { transform: none; } 93% { transform: translateX(-6px) skewX(-6deg); } 95% { transform: translateX(5px); } 97% { transform: translateX(-2px); } }
    .num small { display: block; font: 700 14px var(--mono); letter-spacing: .3em; text-indent: .3em; color: rgba(237,232,225,.7); margin-bottom: 14px; text-shadow: none; }
    .txt { max-width: 340px; font-size: 16px; line-height: 1.45; color: rgba(237,232,225,.88); margin-top: 18px; }
    .txt b { color: var(--bone); }
    .frase { max-width: 330px; font-size: 18px; line-height: 1.4; font-style: italic; color: var(--bone); margin-top: 18px; }
    .btn { margin-top: 24px; padding: 14px 28px; border: 0; background: var(--red-deep); color: #fff; font: 700 15px "BSP Helvetica", sans-serif; letter-spacing: .14em; text-indent: .14em; text-transform: uppercase; }

    /* Cargando: las cifras ruedan, una barra de cinta avanza y el texto cambia */
    body.carga .num { animation: jitter .6s infinite; opacity: .85; }
    .barra { width: min(300px, 76vw); height: 14px; margin-top: 26px; padding: 3px; border: 2px solid rgba(237,232,225,.8); }
    .barra i { display: block; height: 100%; width: 0; background: var(--red); box-shadow: 0 0 14px rgba(255,40,25,.8); }
    .estado { margin-top: 14px; font: 700 13px var(--mono); letter-spacing: .14em; color: rgba(237,232,225,.8); min-height: 1.4em; }
    .estado::after { content: "▌"; margin-left: .3em; animation: blink .8s steps(1) infinite; }
    body.carga .bg { animation: tiron 1.1s steps(1) infinite; }
    @keyframes tiron { 0%, 70%, 100% { transform: scale(1.06); } 72% { transform: scale(1.06) translateX(-14px); filter: blur(6px) brightness(.5) hue-rotate(40deg); } 76% { transform: scale(1.06) translateX(9px); } }
    /* Destello al revelar */
    .flash { position: fixed; inset: 0; z-index: 5; pointer-events: none; background: #fff; opacity: 0; }
    .flash.on { animation: flash .5s ease-out; }
    @keyframes flash { 0% { opacity: .85; } 100% { opacity: 0; } }

    /* Ha ganado: la pantalla se enciende en rojo para que se vea de lejos en la barra */
    body.gana .bg { filter: blur(6px) brightness(.55) saturate(1.6); }
    body.gana::after { content: ""; position: fixed; inset: 0; z-index: -1; background: var(--red-deep); mix-blend-mode: multiply; animation: pulse 1.2s ease-in-out infinite alternate; }
    @keyframes pulse { from { opacity: .55; } to { opacity: .95; } }
    body.gana .kicker { color: #fff; }
    body.gana .num, body.entregado .num { font-size: clamp(72px, 25vw, 160px); margin-top: 16px; }
    body.gana .num { text-shadow: .035em 0 rgba(255,255,255,.5), 0 0 40px rgba(255,255,255,.7); }
    body.gana .frase, body.entregado .frase { font-size: 16px; }
    .premio { margin-top: 18px; padding: 12px 22px; border: 2px solid #fff; background: rgba(0,0,0,.35); font-family: "BSP Helvetica Black", sans-serif; font-weight: 900;
      font-size: clamp(20px, 6.4vw, 30px); line-height: 1.05; letter-spacing: -.02em; text-transform: uppercase; color: #fff; box-shadow: 0 0 30px rgba(255,255,255,.35); }
    .premio small { display: block; font: 700 12px var(--mono); letter-spacing: .3em; text-indent: .3em; margin-bottom: 6px; opacity: .8; }
    body.entregado .num { opacity: .45; animation: none; }
    body.entregado .premio { opacity: .5; box-shadow: none; }

    /* No ha ganado: la escena se apaga a gris y el número se queda como un fantasma */
    body.pierde .bg { filter: blur(8px) brightness(.22) grayscale(1); }
    body.pierde h1 { font-size: clamp(54px, 17vw, 110px); margin-bottom: 4px; }
    body.pierde .num { font-size: clamp(54px, 18vw, 110px); opacity: .35; animation: none; text-shadow: none; margin-top: 10px; }
    [hidden] { display: none !important; }
  </style>
</head>
<body data-opens={OPENS} data-closes={CLOSES} data-gana={JSON.stringify(FRASES_GANA)} data-pierde={JSON.stringify(FRASES_GAME_OVER)}>
  <div class="bg"></div>
  <div class="fx"></div>
  <div class="flash" id="flash"></div>
  <div class="osd osd--l">PLAY ▶</div>
  <div class="osd osd--r rec" id="reloj">--:--:--</div>

  <p class="kicker" id="kicker">Halloween Fest V · El juego</p>
  <h1 id="titulo" hidden></h1>
  <div class="num" id="num"><small id="numlabel">TU NÚMERO</small><span id="cifra">#0000</span></div>
  <div class="barra" id="barra"><i id="progreso"></i></div>
  <p class="estado" id="estado">CONECTANDO</p>
  <p class="premio" id="premio" hidden><small>TU PREMIO</small><span id="premiotxt"></span></p>
  <p class="frase" id="frase" hidden></p>
  <p class="txt" id="txt" hidden></p>
  <button class="btn" id="reintentar" hidden>Reintentar</button>

  <div class="osd osd--l osd--b">HALLOWEEN FEST V</div>
  <div class="osd osd--r osd--b">CH 05</div>

  <script>
    const prueba = new URLSearchParams(location.search).has("prueba");
    const q = prueba ? "?prueba" : "";
    const $ = (id: string) => document.getElementById(id)!;
    const ds = document.body.dataset;
    const opens = Number(ds.opens), closes = Number(ds.closes);
    const frasesGana: string[] = JSON.parse(ds.gana!), frasesPierde: string[] = JSON.parse(ds.pierde!);
    const azar4 = () => "#" + String(Math.random() * 10000 | 0).padStart(4, "0");
    const show = (id: string, on = true) => { $(id).hidden = !on; };

    // Reloj en vivo: en la barra se ve que es la página de verdad y no una captura.
    const tick = () => { $("reloj").textContent = new Date().toLocaleTimeString("es-ES", { hour12: false }); };
    tick(); setInterval(tick, 1000);

    // Id aleatorio del móvil, guardado para que vuelva a ver su número.
    const store = prueba ? "juego5p-g5" : "juego5";
    const get = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
    const set = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };
    const cookie = (k: string) => document.cookie.split("; ").find((c) => c.startsWith(k + "="))?.split("=")[1] ?? null;
    let id = get(`${store}-id`) || cookie(`${store}-id`);
    if (!id) id = crypto.randomUUID?.() ?? Array.from(crypto.getRandomValues(new Uint8Array(16)), (b) => b.toString(16).padStart(2, "0")).join("");
    set(`${store}-id`, id);
    document.cookie = `${store}-id=${id}; max-age=${60 * 60 * 24 * 30}; path=/; samesite=lax`;

    type Res = { n: string; premio: string | null };
    const guardado = (): Res | null => {
      try { const r = JSON.parse(get(`${store}-res`) || "null"); return typeof r?.n === "string" ? r : null; } catch { return null; }
    };

    // ── Espera: unos 3 s la primera vez (1 s si ya tenía número) ──
    const MENSAJES = ["CONECTANDO", "LEYENDO TU CÓDIGO", "ASIGNANDO NÚMERO", "EL JUEGO ESTÁ DECIDIENDO", "TU DESTINO ESTÁ ESCRITO"];
    function esperar(ms: number): Promise<void> {
      document.body.classList.add("carga");
      const t0 = performance.now();
      return new Promise((fin) => {
        const paso = () => {
          const t = Math.min(1, (performance.now() - t0) / ms);
          // La barra avanza a trompicones, como una cinta que se atasca.
          $("progreso").style.width = `${Math.round((t < .85 ? t * .9 : .765 + (t - .85) * 1.57) * 100)}%`;
          $("estado").textContent = MENSAJES[Math.min(MENSAJES.length - 1, Math.floor(t * MENSAJES.length))];
          $("cifra").textContent = azar4();
          if (t < 1) setTimeout(paso, 60); else fin();
        };
        paso();
      });
    }

    function aviso(titulo: string, txt: string) {
      document.body.classList.remove("carga");
      show("num", false); show("barra", false); show("estado", false);
      $("titulo").textContent = titulo; show("titulo");
      $("txt").textContent = txt; show("txt");
    }

    function revelar(r: Res) {
      document.body.classList.remove("carga");
      show("barra", false); show("estado", false);
      $("flash").classList.add("on");
      $("cifra").textContent = `#${r.n}`;
      if (r.premio) {
        document.body.classList.add("gana");
        $("kicker").textContent = "¡Has ganado!";
        $("premiotxt").textContent = r.premio; show("premio");
        $("frase").textContent = `«${frasesGana[Number(r.n) % frasesGana.length]}»`; show("frase");
        $("txt").innerHTML = "<b>Acércate a la barra</b> y enseña esta pantalla."; show("txt");
        navigator.vibrate?.([300, 120, 300, 120, 600]);
        vigilar(r.n);
      } else {
        document.body.classList.add("pierde");
        $("titulo").textContent = "Game over"; show("titulo");
        $("frase").textContent = `«${frasesPierde[Number(r.n) % frasesPierde.length]}»`; show("frase");
      }
    }

    // Ganador: avisa cuando en el panel se marca su premio como entregado.
    function vigilar(n: string) {
      const mirar = async (ahora = false) => {
        if (!ahora && document.visibilityState !== "visible") return;
        try {
          const d = await (await fetch(`/api/juego${q}`)).json();
          const entregado = Boolean(d.ok?.includes(n));
          document.body.classList.toggle("entregado", entregado);
          document.body.classList.toggle("gana", !entregado);
          $("kicker").textContent = entregado ? "Premio entregado" : "¡Has ganado!";
          $("numlabel").textContent = entregado ? "YA RECOGIDO" : "TU NÚMERO";
          $("txt").innerHTML = entregado ? "Este premio ya se ha entregado. ¡Enhorabuena!" : "<b>Acércate a la barra</b> y enseña esta pantalla.";
        } catch {}
      };
      mirar(true); setInterval(mirar, 8000);
      document.addEventListener("visibilitychange", () => mirar());
    }

    async function jugar() {
      show("reintentar", false); show("txt", false); show("titulo", false);
      show("num"); show("barra"); show("estado");
      const previo = guardado();
      const pedir = fetch("/api/juego", { method: "POST", body: JSON.stringify({ id, prueba }) }).then((r) => r.json());
      try {
        const [d] = await Promise.all([pedir, esperar(previo ? 1000 : 3000)]);
        if (d.estado === "fuera") {
          if (previo) return revelar(previo);
          return Date.now() < opens
            ? aviso("Aún no ha empezado", "El juego se abre la noche del 31. Escanea el código cuando aparezca en la pantalla.")
            : aviso("El juego ha terminado", "Gracias por jugar. Nos vemos en la próxima.");
        }
        if (!d.n) throw new Error(d.error || "sin número");
        const r: Res = { n: d.n, premio: d.premio ?? null };
        set(`${store}-res`, JSON.stringify(r));
        revelar(r);
      } catch {
        if (previo) return revelar(previo);
        aviso("Sin señal", "No hemos podido conectar con el juego. Comprueba la conexión y vuelve a intentarlo.");
        show("reintentar");
      }
    }
    $("reintentar").addEventListener("click", jugar);

    if (Date.now() >= closes && !prueba && !guardado()) aviso("El juego ha terminado", "Gracias por jugar. Nos vemos en la próxima.");
    else jugar();
  </script>
</body>
</html>
