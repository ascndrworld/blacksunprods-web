<!-- ── Estilos de los marcadores (botones creados por JS → fuera del scope de Astro) ── -->
<style is:global>
  /* Proceso → barras "palito" con relleno de progreso (premium) */
  .proc-dot {
    width: 20px;
    height: 3px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: rgba(243, 243, 240, 0.2);
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: width 0.45s cubic-bezier(0.4, 0, 0.2, 1), background 0.3s ease;
  }
  .proc-dot[aria-selected="true"] {
    width: 48px;
    background: rgba(243, 243, 240, 0.22);
  }
  /* Relleno que acompaña al autoplay (5s, sincronizado con el temporizador JS) */
  .proc-dot[aria-selected="true"]::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: #F3F3F0;
    transform: scaleX(0);
    transform-origin: left center;
    animation: procFill 5s linear forwards;
  }
  @keyframes procFill { to { transform: scaleX(1); } }
  /* En pausa (tras tocar): la barra activa queda fija y llena, sin animación */
  .proc-dots.is-paused .proc-dot[aria-selected="true"] { background: #F3F3F0; }
  .proc-dots.is-paused .proc-dot[aria-selected="true"]::after { display: none; }

  /* Testimonios → puntos con halo (premium) */
  .tst-dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(243, 243, 240, 0.25);
    cursor: pointer;
    transition: background 0.35s ease, box-shadow 0.35s ease, transform 0.35s ease;
  }
  .tst-dot[aria-selected="true"] {
    background: #F3F3F0;
    transform: scale(1.15);
    box-shadow: 0 0 0 4px rgba(243, 243, 240, 0.14);
  }
</style>


