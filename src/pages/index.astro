  <!-- ════ EL PROCESO ════ -->
  <section class="proc proc-h" id="proceso">
    <div class="proc-pin">
      <div class="proc-sticky">
        <div class="proc-head">
          <span class="proc-eyebrow">FROM CONCEPT TO CROWD</span>
          <h2 class="proc-title">El proceso</h2>
        </div>
        <div class="proc-viewport">
          <ol class="proc-track">
        <li class="proc-panel">
          <span class="proc-num">01</span>
          <div class="proc-text">
            <h3 class="proc-name">Concepto</h3>
            <p class="proc-desc">Entendemos el evento, el público y el objetivo. Definimos la idea, el formato y la experiencia que queremos crear.</p>
          </div>
        </li>
        <li class="proc-panel">
          <span class="proc-num">02</span>
          <div class="proc-text">
            <h3 class="proc-name">Producción</h3>
            <p class="proc-desc">Presupuesto, cartel artístico, proveedores, permisos, seguridad y ticketing. Todo planificado y bajo un único responsable.</p>
          </div>
        </li>
        <li class="proc-panel">
          <span class="proc-num">03</span>
          <div class="proc-text">
            <h3 class="proc-name">Montaje</h3>
            <p class="proc-desc">Sonido, iluminación, pantalla LED, escenario y accesos. Coordinamos a cada equipo para que todo esté listo a tiempo.</p>
          </div>
        </li>
        <li class="proc-panel">
          <span class="proc-num">04</span>
          <div class="proc-text">
            <h3 class="proc-name">Ejecución</h3>
            <p class="proc-desc">Dirigimos la operación en directo: artistas, personal, barra, accesos y tiempos. Control total durante el evento.</p>
          </div>
        </li>
        <li class="proc-panel">
          <span class="proc-num">05</span>
          <div class="proc-text">
            <h3 class="proc-name">Público</h3>
            <p class="proc-desc">La gente vive la experiencia. Después, desmontaje, material audiovisual y una memoria con resultados para la siguiente edición.</p>
          </div>
        </li>
          </ol>
        </div>
        <div class="proc-controls">
          <button class="proc-arrow" type="button" data-dir="-1" aria-label="Paso anterior">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4.5 7.5 12 15 19.5"/></svg>
          </button>
          <div class="proc-dots" role="tablist" aria-label="Navegación del proceso"></div>
          <button class="proc-arrow" type="button" data-dir="1" aria-label="Paso siguiente">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4.5 16.5 12 9 19.5"/></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

