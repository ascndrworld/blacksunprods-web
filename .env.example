# ─────────────────────────────────────────────────────────────
# Variables de tracking — copia este archivo a ".env" y rellena
# los valores. Deja vacía cualquier herramienta que no uses.
#
#   cp .env.example .env
#
# El prefijo PUBLIC_ es obligatorio (Astro las expone al cliente).
# ─────────────────────────────────────────────────────────────

# Google Tag Manager — ID del contenedor (formato GTM-XXXXXXX)
PUBLIC_GTM_ID=

# Google Analytics 4 — ID de medición (formato G-XXXXXXXXXX)
# Si configuras GA4 DENTRO de GTM, deja esto vacío para no duplicar datos.
PUBLIC_GA4_ID=

# Meta Pixel — ID numérico del píxel de Facebook/Instagram
# Si configuras el píxel DENTRO de GTM, deja esto vacío.
PUBLIC_META_PIXEL_ID=

# Google Search Console — token de la etiqueta de verificación HTML
PUBLIC_GSC_VERIFICATION=

# ─────────────────────────────────────────────────────────────
# Informe de GA4 (solo servidor — NO llevan prefijo PUBLIC_).
# Usado por: npm run report:ga  (scripts/ga-report.mjs)
# ─────────────────────────────────────────────────────────────

# ID NUMÉRICO de la propiedad GA4 (NO es el "G-XXXX", es un número).
# Analytics → Administrar → Configuración de la propiedad → "ID de la propiedad".
GA4_PROPERTY_ID=

# Ruta al JSON de la cuenta de servicio con acceso de lectura a la propiedad.
GOOGLE_APPLICATION_CREDENTIALS=./ga-credentials.json

# ─────────────────────────────────────────────────────────────
# Airtable — CRM de leads (solo servidor, SIN prefijo PUBLIC_).
# Usado por: src/pages/api/contacto.ts (createLead)
# Si se deja vacío, el formulario sigue funcionando: solo se
# omite el alta en el CRM (aviso por consola).
# ─────────────────────────────────────────────────────────────

# Personal access token de Airtable (empieza por "pat…") con permiso
# data.records:write sobre la base.
AIRTABLE_TOKEN=

# ID de la base (empieza por "app…"). Está en la URL de la base.
AIRTABLE_BASE_ID=

# Nombre o ID de la tabla. Debe tener los campos: Nombre, Email,
# Tipo de cliente, Tipo de evento, Municipio/Recinto, Fecha, Aforo
# (todos texto), Consulta, Estado (single select con "Nuevo"),
# Fuente (single select con "Web").
AIRTABLE_TABLE=Leads

# ─────────────────────────────────────────────────────────────
# Indexación en buscadores. Por defecto la web NO se indexa
# (noindex + robots Disallow). Poner "true" SOLO en el despliegue
# final con el dominio blacksunprods.com.
# ─────────────────────────────────────────────────────────────
PUBLIC_INDEXABLE=
